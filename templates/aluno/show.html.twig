{% extends 'base.html.twig' %}
{% block title %}{{ aluno.nome }} | Alunos{% endblock %}
{% block body %}<link rel="stylesheet" href="{{ asset('styles/students.css') }}">
<div class="page-head student-detail-head"><div><a class="back-link" href="{{ path('app_crud_index',{resource:'alunos'}) }}">← Alunos</a><h1>{{ aluno.nome }}</h1><p>Dados completos do aluno</p></div><a class="primary-btn" href="{{ path('app_crud_edit',{resource:'alunos',id:aluno.id}) }}">✎ Editar</a></div>
<section class="student-detail-grid"><article class="panel student-profile-card"><div class="student-profile-photo">{% if photos %}<img src="{{ photos[0].caminho }}" alt="Foto de {{ aluno.nome }}">{% else %}<span>{{ aluno.nome|slice(0,1)|upper }}</span>{% endif %}</div><h2>{{ aluno.nome }}</h2><i class="badge {{ aluno.status=='ativo'?'ok':'off' }}">{{ aluno.status|capitalize }}</i><small>{{ aluno.idade }} anos</small></article><article class="panel student-data-card"><h3>Dados pessoais e matrícula</h3><dl><div><dt>Data de nascimento</dt><dd>{{ aluno.dataNascimento|date('d/m/Y') }}</dd></div><div><dt>CPF</dt><dd>{{ aluno.cpf ?: 'Não informado' }}</dd></div><div><dt>Telefone</dt><dd>{{ aluno.telefone ?: 'Não informado' }}</dd></div><div><dt>Turma</dt><dd>{{ aluno.turma ? aluno.turma.nome : 'Sem turma' }}</dd></div><div><dt>Pontuação</dt><dd>{{ aluno.pontuacao }} pontos</dd></div><div><dt>Responsável</dt><dd>{{ aluno.responsavel ? aluno.responsavel.nome : 'Não informado' }}</dd></div><div><dt>Usuário vinculado</dt><dd>{{ aluno.usuario ? aluno.usuario.nome : 'Não vinculado' }}</dd></div>{% if aluno.responsavel %}<div><dt>Telefone do responsável</dt><dd>{{ aluno.responsavel.telefone ?: 'Não informado' }}</dd></div><div><dt>E-mail do responsável</dt><dd>{{ aluno.responsavel.email ?: 'Não informado' }}</dd></div>{% endif %}</dl></article></section>
<article class="panel student-criteria-card"><h3>Critérios de qualificação</h3><div class="student-criteria-list">{% for criterio in aluno.criterios %}<span><b>{{ criterio.nome }}</b><small>{{ criterio.descricao ?: 'Sem descrição' }}</small><strong>+{{ criterio.pontos }}</strong></span>{% else %}<p>Nenhum critério selecionado.</p>{% endfor %}</div></article>
<article class="panel student-gallery-panel"><div class="student-gallery-title"><div><h3>Fotos do aluno</h3><p>{{ photos|length }} foto(s) armazenada(s)</p></div><form method="post" enctype="multipart/form-data" class="student-photo-form"><input type="hidden" name="_token" value="{{ csrf_token('student-photos-'~aluno.id) }}"><label><input type="file" name="fotos[]" accept="image/jpeg,image/png,image/webp" multiple required><span>＋ Adicionar fotos</span></label><button type="submit">Enviar</button></form></div><p class="photo-help">JPG, PNG ou WebP · máximo de 5 MB por foto · até 8 por envio.</p><div class="lesson-photo-grid">{% for photo in photos %}<figure><a href="{{ photo.caminho }}" target="_blank" rel="noopener"><img src="{{ photo.caminho }}" alt="{{ photo.nomeOriginal }}" loading="lazy"></a><figcaption><span title="{{ photo.nomeOriginal }}">{{ photo.nomeOriginal }}</span><small>{{ (photo.tamanho/1024/1024)|number_format(2,',','.') }} MB</small><form method="post" action="{{ path('app_aluno_photo_delete',{alunoId:aluno.id,id:photo.id}) }}" onsubmit="return confirm('Excluir esta foto?')"><input type="hidden" name="_token" value="{{ csrf_token('delete-student-photo-'~photo.id) }}"><button class="icon-action danger" title="Excluir foto" aria-label="Excluir foto">×</button></form></figcaption></figure>{% else %}<div class="empty"><p>Nenhuma foto adicionada a este aluno.</p></div>{% endfor %}</div></article>
{% endblock %}
