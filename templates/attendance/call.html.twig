{% extends 'base.html.twig' %}
{% block title %}Execução e frequência — {{ aula.titulo }}{% endblock %}
{% block body %}
<div class="execution-page-head"><a class="secondary-btn" href="{{ path('app_aula_index') }}">← Voltar para aulas</a><div><h1>{{ aula.titulo }} — Execução e Frequência</h1><p>{{ aula.turma.nome }} · {{ aula.dataHora|date('d/m/Y H:i') }}</p></div></div>
<form method="post" enctype="multipart/form-data" class="execution-attendance-form"><input type="hidden" name="_token" value="{{ csrf_token('attendance-'~aula.id) }}"><section class="panel execution-panel"><h3>Execução da aula</h3><p>Registre o que realmente foi executado nesta aula.</p><label>O que foi executado?<textarea name="execucao" rows="12" placeholder="Descreva as atividades, conteúdos e resultados da aula...">{{ aula.execucao }}</textarea></label><label>Materiais da execução<textarea name="materiais" rows="4" placeholder="Links ou descrição dos PDFs e documentos utilizados...">{{ aula.materiais }}</textarea></label><label class="lesson-photo-upload"><span>Fotos da execução</span><small>JPG, PNG ou WebP · máximo de 5 MB por foto · até 8 por envio</small><input type="file" name="fotos[]" accept="image/jpeg,image/png,image/webp" multiple data-photo-input><b>＋ Selecionar fotos</b><em data-photo-summary>Nenhuma foto selecionada</em></label></section><section class="panel roll-call-panel"><h3>Lista de frequência</h3><p>Marque a situação de cada aluno nesta aula.</p><div class="attendance-toolbar"><button type="button" data-mark-all="presente">Todos presentes</button><button type="button" data-mark-all="ausente">Todos ausentes</button></div><div class="visual-roll-call">{% for aluno in alunos %}{% set record=records[aluno.id]|default(null) %}{% set situation=record ? record.situacao : 'presente' %}<div class="visual-student-row"><div><b>{{ aluno.nome }}</b><small>{{ aluno.idade }} anos{% if aluno.responsavel %} · {{ aluno.responsavel.nome }}{% endif %}</small></div><div class="attendance-options"><label class="present"><input type="radio" name="situacao[{{ aluno.id }}]" value="presente" {{ situation=='presente'?'checked':'' }}> Presente</label><label class="absent"><input type="radio" name="situacao[{{ aluno.id }}]" value="ausente" {{ situation=='ausente'?'checked':'' }}> Ausente</label><label><input type="radio" name="situacao[{{ aluno.id }}]" value="atrasado" {{ situation=='atrasado'?'checked':'' }}> Atrasado</label><label><input type="radio" name="situacao[{{ aluno.id }}]" value="justificada" {{ situation=='justificada'?'checked':'' }}> Justificada</label></div><input class="attendance-note" name="justificativa[{{ aluno.id }}]" value="{{ record ? record.justificativa : '' }}" placeholder="Justificativa/observação"></div>{% else %}<div class="empty"><h3>Turma sem alunos ativos</h3></div>{% endfor %}</div>{% if channels %}<div class="attendance-notify"><label><input type="checkbox" name="notificarAusencias" value="1"> Notificar responsáveis dos ausentes</label><div>{% for channel in channels %}<label><input type="checkbox" name="canais[]" value="{{ channel }}" checked> {{ channel == 'email' ? 'E-mail' : 'SMS' }}</label>{% endfor %}</div></div>{% endif %}</section><div class="execution-save"><button type="submit" class="primary-btn">Salvar execução, fotos e frequência</button></div></form>
<article class="panel lesson-gallery-panel"><h3>Galeria da execução <small>{{ photos|length }} foto(s)</small></h3><div class="lesson-photo-grid">{% for photo in photos %}<figure><a href="{{ photo.caminho }}" target="_blank" rel="noopener"><img src="{{ photo.caminho }}" alt="{{ photo.nomeOriginal }}" loading="lazy"></a><figcaption><span title="{{ photo.nomeOriginal }}">{{ photo.nomeOriginal }}</span><small>{{ (photo.tamanho/1024/1024)|number_format(2,',','.') }} MB</small><form method="post" action="{{ path('app_lesson_photo_delete',{aulaId:aula.id,id:photo.id}) }}" onsubmit="return confirm('Excluir esta foto?')"><input type="hidden" name="_token" value="{{ csrf_token('delete-lesson-photo-'~photo.id) }}"><button class="icon-action danger" title="Excluir foto" aria-label="Excluir foto">×</button></form></figcaption></figure>{% else %}<div class="empty"><p>Nenhuma foto adicionada à execução desta aula.</p></div>{% endfor %}</div></article>
<script>document.querySelectorAll('[data-mark-all]').forEach(button=>button.addEventListener('click',()=>document.querySelectorAll(`input[type="radio"][value="${button.dataset.markAll}"]`).forEach(input=>input.checked=true)));const photoInput=document.querySelector('[data-photo-input]');photoInput?.addEventListener('change',()=>{const count=photoInput.files.length;document.querySelector('[data-photo-summary]').textContent=count?`${count} foto(s) selecionada(s)`:'Nenhuma foto selecionada'})</script>
{% endblock %}
