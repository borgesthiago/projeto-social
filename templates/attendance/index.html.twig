{% extends 'base.html.twig' %}
{% block title %}Controle Geral de Frequência{% endblock %}
{% block body %}
<div class="page-head attendance-overview-head"><div><h1><span>♧</span> Controle Geral de Frequência</h1><p>Visualize e filtre os registros de presença de todos os alunos.</p></div></div>
<article class="panel attendance-filter-panel"><h3>▽ Filtros</h3><form method="get" data-attendance-filter><input name="aluno" value="{{ filters.aluno }}" placeholder="Nome do aluno" data-name-filter><select name="turma" data-auto-filter><option value="">Todas as turmas</option>{% for turma in classes %}<option value="{{ turma.id }}" {{ filters.turma==turma.id?'selected':'' }}>{{ turma.nome }}</option>{% endfor %}</select><label><span>Data inicial</span><input type="date" name="inicio" value="{{ filters.inicio }}" data-auto-filter></label><label><span>Data final</span><input type="date" name="fim" value="{{ filters.fim }}" data-auto-filter></label><a href="{{ path('app_attendance_index') }}">× Limpar filtros</a><button type="submit">Filtrar</button></form></article>
<article class="panel attendance-results"><h3>Resultados <small>({{ records|length }} registro(s))</small></h3><div class="attendance-table"><div class="attendance-result-row attendance-result-header"><span>Aluno</span><span>Turma</span><span>Aula</span><span>Data</span><span>Professor</span><span>Status</span></div>{% for record in records %}<div class="attendance-result-row"><span><b>{{ record.aluno.nome }}</b></span><span>{{ record.aula.turma.nome }}</span><span>{{ record.aula.titulo }}</span><span>{{ record.aula.dataHora|date('d/m/Y') }}</span><span>{{ record.aula.turma.professor ? record.aula.turma.professor.nome : 'Não definido' }}</span><span><i class="attendance-status {{ record.situacao }}">{{ record.situacao == 'justificada' ? 'Falta justificada' : record.situacao|capitalize }}</i></span></div>{% else %}<div class="empty large"><span>○</span><h3>Nenhum registro encontrado</h3><p>Faça a chamada de uma aula ou altere os filtros utilizados.</p></div>{% endfor %}</div></article>
<script>const filterForm=document.querySelector('[data-attendance-filter]');document.querySelectorAll('[data-auto-filter]').forEach(field=>field.addEventListener('change',()=>filterForm.submit()));let filterTimer;document.querySelector('[data-name-filter]')?.addEventListener('input',()=>{clearTimeout(filterTimer);filterTimer=setTimeout(()=>filterForm.submit(),500)})</script>
{% endblock %}
