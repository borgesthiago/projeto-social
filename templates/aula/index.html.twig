{% extends 'base.html.twig' %}
{% block title %}Gestão de Aulas{% endblock %}
{% block body %}
<div class="page-head"><div><h1><span>▣</span> Gestão de Aulas</h1><p>Cada aula é individual: Planejamento → Execução → Frequência.</p></div><a class="primary-btn" href="{{ path('app_crud_new',{resource:'aulas'}) }}">＋ Nova aula</a></div>
<form class="toolbar class-search" method="get"><input name="q" value="{{ q }}" placeholder="Pesquisar aula ou turma..."><button>Pesquisar</button>{% if q %}<a href="{{ path('app_aula_index') }}">Limpar</a>{% endif %}</form>
<div class="lesson-stats"><article><strong>{{ stats.planejada }}</strong><small>Agendada</small><span>▣</span></article><article><strong>{{ stats.andamento }}</strong><small>Em andamento</small><span>◷</span></article><article><strong>{{ stats.finalizada }}</strong><small>Finalizada</small><span>✓</span></article><article><strong>{{ stats.cancelada }}</strong><small>Cancelada</small><span>×</span></article></div>
<div class="lesson-card-grid">{% for lesson in lessons %}<article class="lesson-management-card"><header><div><h2>{{ lesson.titulo }}</h2><small>Turma: {{ lesson.turma ? lesson.turma.nome : 'Não definida' }}</small></div><i class="lesson-status {{ lesson.status }}">{{ lesson.status }}</i></header><div class="lesson-info"><span>▣ {{ lesson.dataHora|date('d/m/Y') }}</span><span>◷ {{ lesson.dataHora|date('H:i') }}</span><span>♙ {{ lesson.turma and lesson.turma.professor ? lesson.turma.professor.nome : 'Professor não definido' }}</span></div><footer><div class="lesson-tags">{% if lesson.planejamento %}<button type="button" class="planned" data-dialog="planning-{{ lesson.id }}">▣ Planejado</button>{% endif %}{% if lesson.execucao %}<span class="executed">▤ Executado</span>{% endif %}{% if attendance[lesson.id] %}<span class="frequency">Frequência OK</span>{% endif %}</div><div class="actions">{% if lesson.planejamento %}<button type="button" class="icon-action" data-dialog="planning-{{ lesson.id }}" title="Ver planejamento" aria-label="Ver planejamento">▣</button>{% endif %}<a class="icon-action enroll" href="{{ path('app_attendance_call',{id:lesson.id}) }}" title="Execução e frequência" aria-label="Execução e frequência">◉</a><a class="icon-action" href="{{ path('app_crud_edit',{resource:'aulas',id:lesson.id}) }}" title="Editar aula" aria-label="Editar aula">✎</a><form method="post" action="{{ path('app_crud_delete',{resource:'aulas',id:lesson.id}) }}" onsubmit="return confirm('Excluir esta aula?')"><input type="hidden" name="_token" value="{{ csrf_token('delete-aulas-'~lesson.id) }}"><button class="icon-action danger" title="Excluir aula" aria-label="Excluir aula">×</button></form></div></footer></article>{% if lesson.planejamento %}<dialog id="planning-{{ lesson.id }}" class="planning-dialog"><button type="button" class="dialog-close" data-close aria-label="Fechar">×</button><h2>Planejamento — {{ lesson.titulo }}</h2><div class="planning-meta"><span><b>Data:</b> {{ lesson.dataHora|date('d/m/Y') }}</span><span><b>Horário:</b> {{ lesson.dataHora|date('H:i') }}</span></div><h3>Conteúdo planejado</h3><p>{{ lesson.planejamento|nl2br }}</p>{% if lesson.materiais %}<h3>Materiais</h3><p>{{ lesson.materiais|nl2br }}</p>{% endif %}</dialog>{% endif %}{% else %}<article class="panel empty large"><span>○</span><h3>Nenhuma aula encontrada</h3><p>Cadastre uma aula vinculada a uma turma.</p></article>{% endfor %}</div>
<script>document.querySelectorAll('[data-dialog]').forEach(button=>button.addEventListener('click',()=>document.getElementById(button.dataset.dialog)?.showModal()));document.querySelectorAll('[data-close]').forEach(button=>button.addEventListener('click',()=>button.closest('dialog').close()));document.querySelectorAll('dialog').forEach(dialog=>dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close()}));</script>
{% endblock %}
