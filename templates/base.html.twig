<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{% block title %}Projeto Social{% endblock %}</title><link rel="stylesheet" href="{{ asset('styles/app.css') }}?v=20260804-2"><link rel="stylesheet" href="{{ asset('styles/activity.css') }}"><link rel="stylesheet" href="{{ asset('styles/attendance.css') }}"><link rel="stylesheet" href="{{ asset('styles/student-form.css') }}"><link rel="stylesheet" href="{{ asset('styles/action-icons.css') }}"><link rel="stylesheet" href="{{ asset('styles/classes.css') }}"><link rel="stylesheet" href="{{ asset('styles/lessons.css') }}"><link rel="stylesheet" href="{{ asset('styles/execution.css') }}"><link rel="stylesheet" href="{{ asset('styles/photos.css') }}"><link rel="stylesheet" href="{{ asset('styles/attendance-overview.css') }}"><link rel="stylesheet" href="{{ asset('styles/waitlist.css') }}"><link rel="stylesheet" href="{{ asset('styles/finance.css') }}"><link rel="stylesheet" href="{{ asset('styles/reports.css') }}"><link rel="stylesheet" href="{{ asset('styles/users.css') }}">{% if app.user and app.user.projeto %}<style>:root{--blue:{{ app.user.projeto.corPrimaria }};--secondary:{{ app.user.projeto.corSecundaria }};--button-text:{{ app.user.projeto.corTextoBotao }};--sidebar-bg:{{ app.user.projeto.corSidebar }}}</style>{% endif %}</head><body>{% if app.user %}<div class="shell"><aside><a class="brand" href="{{ path('app_dashboard') }}">{% if app.user.projeto.logoPath|default(null) %}<img class="brand-logo" src="{{ app.user.projeto.logoPath }}" alt="Logo de {{ app.user.projeto.nome }}">{% else %}<span>PS</span>{% endif %}<div>{{ app.user.projeto.nome|default('Projeto Social') }}<small>{{ app.user.projeto.slogan|default('Gestão & Impacto') }}</small></div></a><nav>{% set nav_items=[
['⌂','Visão geral','app_dashboard',null,[],null],['♙','Usuários','app_users_index',null,['ROLE_MASTER'],null],['◉','Alunos','app_crud_index','alunos',['ROLE_MASTER','ROLE_ADMINISTRATIVO'],'gestao_alunos'],['♙','Responsáveis','app_crud_index','responsaveis',['ROLE_MASTER','ROLE_ADMINISTRATIVO'],'gestao_alunos'],['♙','Professores','app_crud_index','professores',['ROLE_MASTER','ROLE_ADMINISTRATIVO'],'gestao_turmas'],['▤','Modalidades e cursos','app_crud_index','modalidades',['ROLE_MASTER','ROLE_ADMINISTRATIVO'],'modalidades_cursos'],['▦','Turmas','app_turma_index',null,['ROLE_MASTER','ROLE_ADMINISTRATIVO','ROLE_PROFESSOR'],'gestao_turmas'],['▣','Aulas','app_aula_index',null,['ROLE_MASTER','ROLE_ADMINISTRATIVO','ROLE_PROFESSOR'],'gestao_aulas'],['✓','Frequência','app_attendance_index',null,['ROLE_MASTER','ROLE_PROFESSOR'],'frequencia'],['≡','Fila de espera','app_waitlist_index',null,['ROLE_MASTER','ROLE_ADMINISTRATIVO'],'fila_espera'],['☷','Critérios da fila','app_crud_index','prioridades',['ROLE_MASTER'],'fila_espera'],['$','Financeiro','app_finance_index',null,['ROLE_MASTER','ROLE_FINANCEIRO'],'financeiro'],['⌁','Relatórios','app_reports_index',null,['ROLE_MASTER'],'relatorios'],['◎','Transparência','app_transparency',null,['ROLE_FINANCEIRO','ROLE_RESPONSAVEL'],'transparencia'],['⚙','Configurações','app_settings',null,['ROLE_MASTER'],null]
] %}{% for nav_item in nav_items %}{% set nav_show=nav_item[4] is empty %}{% for nav_role in nav_item[4] %}{% if is_granted(nav_role) %}{% set nav_show=true %}{% endif %}{% endfor %}{% if nav_show and plan_feature(nav_item[5]) %}<a href="{{ nav_item[2] in ['app_dashboard','app_users_index','app_settings','app_transparency','app_attendance_index','app_turma_index','app_aula_index','app_waitlist_index','app_finance_index','app_reports_index']?path(nav_item[2]):(nav_item[2]=='app_crud_index'?path(nav_item[2],{resource:nav_item[3]}):path(nav_item[2],{slug:nav_item[3]})) }}"><b>{{ nav_item[0] }}</b>{{ nav_item[1] }}</a>{% endif %}{% endfor %}<a href="{{ path('app_help') }}"><b>?</b>Central de ajuda</a></nav><div class="profile"><div class="avatar">{{ app.user.nome|slice(0,1)|upper }}</div><div>{{ app.user.nome }}<small>{% if is_granted('ROLE_MASTER') %}Master{% else %}Usuário{% endif %}</small></div><a href="{{ path('app_logout') }}">Sair</a></div></aside><main><div class="institutional-banner {{ app.user.projeto.bannerPath|default(null)?'custom-banner':'' }}"{% if app.user.projeto.bannerPath|default(null) %} style="background-image:url('{{ app.user.projeto.bannerPath }}')"{% endif %}><button class="menu">☰</button>{% if not app.user.projeto.bannerPath|default(null) %}<div class="hill left"></div><div class="campaign"><b>Dia das Crianças</b><strong>SOLIDÁRIO</strong><small>Ajude a levar alegria para as crianças</small></div><div class="kite">△</div><div class="donate"><strong>Onde doar?</strong><small>Escola municipal · Associação do bairro</small></div><div class="hill right"></div>{% endif %}</div><section class="content">{% for flash_type,flash_messages in app.flashes %}{% for flash_message in flash_messages %}<div class="{{ flash_type=='success'?'success-alert':'alert' }}">{{ flash_message }}</div>{% endfor %}{% endfor %}{% block body %}{% endblock %}</section></main></div>{% else %}{% block guest %}{% endblock %}{% endif %}<script src="{{ asset('scripts/activity.js') }}"></script><script src="{{ asset('scripts/documents.js') }}"></script><script>document.querySelector('.menu')?.addEventListener('click',()=>document.querySelector('aside').classList.toggle('open'))</script></body></html>
