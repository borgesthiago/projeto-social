{% extends 'base.html.twig' %}
{% set back_url = resource == 'turmas' ? path('app_turma_index') : (resource == 'aulas' ? path('app_aula_index') : (resource == 'fila-espera' ? path('app_waitlist_index') : (resource == 'financeiro' ? path('app_finance_index') : (resource == 'prioridades' ? path('app_settings',{tab:'prioridades'}) : path('app_crud_index',{resource:resource}))))) %}
{% block title %}{{ is_new?'Novo':'Editar' }} {{ config.singular }}{% endblock %}
{% block body %}
<div class="page-head"><div><a class="back-link" href="{{ back_url }}">← Voltar</a><h1>{{ is_new?'Novo':'Editar' }} {{ config.singular }}</h1><p>Os dados ficarão disponíveis somente para {{ app.user.projeto.nome }}.</p></div></div>
{% for error in errors %}<div class="alert">{{ error }}</div>{% endfor %}
{% if resource=='responsaveis' %}<article class="registration-qualification"><div><small>Qualificação da completude cadastral — não é perfil de acesso</small><strong>{{ qualification.level }} · {{ qualification.percent }}%</strong><span>{{ qualification.completed }} de {{ qualification.total }} informações preenchidas</span></div><progress value="{{ qualification.percent }}" max="100"></progress>{% if qualification.missing %}<p><b>Dados que podem melhorar o nível:</b> {{ qualification.missing|join(', ') }}.</p>{% endif %}</article>{% endif %}
<form method="post" class="panel crud-form"><input type="hidden" name="_token" value="{{ csrf_token('crud-'~resource) }}"><div class="form-grid">
{% for field in config.fields %}{% set name=field[0] %}{% set type=field[2] %}{% set value=attribute(entity,name) %}<label class="{{ type=='textarea'?'wide':'' }}">{{ field[1] }}{% if field[3] %} *{% endif %}{% if type=='textarea' %}<textarea name="{{ name }}" {{ field[3]?'required':'' }}>{{ value }}</textarea>{% elseif type=='choice' %}<select name="{{ name }}" {{ field[3]?'required':'' }}>{% for key,label in field[4] %}<option value="{{ key }}" {{ value==key?'selected':'' }}>{{ label }}</option>{% endfor %}</select>{% elseif type=='relation' %}<select name="{{ name }}" {{ field[3]?'required':'' }}><option value="">Selecione...</option>{% for option in relations[name] %}<option value="{{ option.id }}" {{ value and value.id==option.id?'selected':'' }}>{{ attribute(option,field[5]) }}</option>{% endfor %}</select>{% elseif type=='boolean' %}<span class="check"><input type="checkbox" name="{{ name }}" value="1" {{ value?'checked':'' }}> Sim</span>{% elseif type=='readonly' %}<input value="{{ value }} pontos" readonly class="readonly-field"><small>Calculada pelos critérios selecionados abaixo.</small>{% else %}<input type="{{ type }}" name="{{ name }}" value="{% if value and type in ['date','datetime-local'] %}{{ value|date(type=='date'?'Y-m-d':'Y-m-d\TH:i') }}{% else %}{{ value }}{% endif %}" {{ field[3]?'required':'' }} {% if name=='valor' %}step="0.01" min="0"{% endif %}>{% endif %}</label>{% endfor %}
</div>
{% if resource=='alunos' %}<section class="student-extra"><h3>Critérios de qualificação</h3><p>Selecione os critérios comprovados. A pontuação será calculada automaticamente.</p><div class="criteria-selection">{% for criterion in criteria %}<label><input type="checkbox" name="criterios[]" value="{{ criterion.id }}" {{ criterion.id in selectedCriteria?'checked':'' }}><span><b>{{ criterion.nome }}</b><small>{{ criterion.descricao|default('Sem descrição') }}</small></span><strong>+{{ criterion.pontos }}</strong></label>{% else %}<div class="empty"><p>Nenhum critério ativo cadastrado.</p></div>{% endfor %}</div><details class="guardian-create" {{ guardianData.nome|default('')?'open':'' }}><summary>＋ Cadastrar novo responsável nesta tela</summary><p>Use este bloco somente se o responsável ainda não estiver disponível no campo “Responsável”.</p><div class="form-grid"><label>Nome completo *<input name="novoResponsavel[nome]" value="{{ guardianData.nome|default('') }}"></label><label>CPF *<input name="novoResponsavel[cpf]" value="{{ guardianData.cpf|default('') }}" data-document="cpf"></label><label>Telefone *<input name="novoResponsavel[telefone]" value="{{ guardianData.telefone|default('') }}"></label><label>E-mail<input type="email" name="novoResponsavel[email]" value="{{ guardianData.email|default('') }}"></label><label><span class="check"><input type="checkbox" name="novoResponsavel[recebeNotificacoes]" value="1" {{ guardianData.recebeNotificacoes|default(false)?'checked':'' }}> Recebe notificações</span></label></div></details></section>{% endif %}
<div class="form-actions"><a href="{{ back_url }}">Cancelar</a><button>Salvar {{ config.singular }}</button></div></form>
{% endblock %}
