{% extends 'base.html.twig' %}
{% block title %}{{ config.title }} | Projeto Social{% endblock %}
{% block body %}
{% if resource=='alunos' %}<style>.student-list-name{display:flex;align-items:center;gap:10px}.student-list-name b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.student-list-avatar{display:grid;place-items:center;flex:0 0 38px;width:38px;height:38px;overflow:hidden;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#10b981);color:#fff;font-style:normal;font-weight:700}.student-list-avatar img{width:100%;height:100%;object-fit:cover}</style>{% endif %}
<div class="page-head"><div><h1><span>▤</span>{{ config.title }}</h1><p>Dados exclusivos de {{ app.user.projeto.nome }}</p></div><div class="page-actions"><a class="primary-btn" href="{{ path('app_crud_new',{resource:resource}) }}">＋ Novo</a></div></div>
{% for message in app.flashes('success') %}<div class="success-alert">{{ message }}</div>{% endfor %}
<article class="panel"><form class="toolbar" method="get"><input name="q" value="{{ q }}" placeholder="Buscar por nome..."><button>Buscar</button></form><div class="crud-table"><div class="crud-row crud-header">{% for field in config.fields|slice(0,4) %}<span>{{ field[1] }}</span>{% endfor %}<span>Ações</span></div>
{% for record in items %}<div class="crud-row">{% for field in config.fields|slice(0,4) %}{% set value=attribute(record,field[0]) %}<span{% if resource=='alunos' and field[0]=='nome' %} class="student-list-name"{% endif %}>{% if resource=='alunos' and field[0]=='nome' %}<i class="student-list-avatar">{% if record.fotos|length %}<img src="{{ record.fotos|first.caminho }}" alt="Foto de {{ record.nome }}" loading="lazy">{% else %}{{ record.nome|slice(0,1)|upper }}{% endif %}</i><b>{{ record.nome }}</b>{% elseif field[2]=='boolean' %}<i class="badge {{ value?'ok':'off' }}">{{ value?'Sim':'Não' }}</i>{% elseif field[2]=='date' or field[2]=='datetime-local' %}{{ value?value|date(field[2]=='date'?'d/m/Y':'d/m/Y H:i'):'—' }}{% elseif field[2]=='relation' %}{{ value?attribute(value,field[5]):'—' }}{% else %}{{ value is not null?value:'—' }}{% endif %}</span>{% endfor %}<span class="actions">{% if resource=='alunos' %}<a class="icon-action" href="{{ path('app_aluno_show',{id:record.id}) }}" title="Visualizar dados completos" aria-label="Visualizar dados completos">◉</a>{% endif %}{% if resource=='aulas' %}<a class="icon-action" href="{{ path('app_attendance_call',{id:record.id}) }}" title="Fazer chamada" aria-label="Fazer chamada">✓</a>{% endif %}{% if resource=='turmas' %}<a class="icon-action" href="{{ path('app_turma_show',{id:record.id}) }}" title="Visualizar turma" aria-label="Visualizar turma">◉</a><a class="icon-action enroll" href="{{ path('app_turma_enroll',{id:record.id}) }}" title="Matricular aluno" aria-label="Matricular aluno">＋</a><a class="icon-action queue" href="{{ path('app_turma_waitlist',{id:record.id}) }}" title="Ver fila de espera" aria-label="Ver fila de espera">≡</a>{% endif %}<a class="icon-action" href="{{ path('app_crud_edit',{resource:resource,id:record.id}) }}" title="Editar" aria-label="Editar">✎</a><form method="post" action="{{ path('app_crud_delete',{resource:resource,id:record.id}) }}" onsubmit="return confirm('Excluir este registro?')"><input type="hidden" name="_token" value="{{ csrf_token('delete-'~resource~'-'~record.id) }}"><button class="icon-action danger" title="Excluir" aria-label="Excluir">×</button></form></span></div>{% else %}<div class="empty large"><span>○</span><h3>Nenhum registro cadastrado</h3><p>Adicione o primeiro registro deste projeto.</p></div>{% endfor %}</div></article>
{% endblock %}
