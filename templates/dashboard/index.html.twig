{% extends 'base.html.twig' %}{% block body %}<div class="dashboard-title"><div><h1>Olá, {{ app.user.nome }}! 👋</h1><p>Bem-vindo ao seu painel de controle</p></div><span class="role-pill">Master</span></div><div class="stats dashboard-stats">{% set cards=[['Total de Alunos',stats.alunos,'♢','blue'],['Aulas Hoje',stats.aulas,'▣','green'],['Turmas Ativas',stats.turmas,'$','amber'],['Fila de Espera',stats.fila,'◷','orange']] %}{% for card in cards %}<article><div><small>{{ card[0] }}</small><strong>{{ card[1] }}</strong>{% if loop.first %}<em>+12% este mês</em>{% endif %}</div><span class="stat-icon {{ card[3] }}">{{ card[2] }}</span></article>{% endfor %}</div><div class="grid dashboard-grid"><article class="panel"><h3><span class="title-icon">▣</span> Próximas Aulas</h3><div class="lesson-row"><div><b>Matemática Básica</b><small>Próxima aula cadastrada</small></div><span>Turma A</span></div><div class="lesson-row"><div><b>Português</b><small>Confira a agenda de aulas</small></div><span>Turma B</span></div></article><article class="panel impact-card"><h3>Resumo Rápido</h3><label>Taxa de Frequência <b>85%</b></label><progress value="85" max="100"></progress><label>Satisfação <b>94%</b></label><progress value="94" max="100"></progress></article></div>{% endblock %}
