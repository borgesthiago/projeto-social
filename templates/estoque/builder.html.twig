{% extends 'base.html.twig' %}{% block title %}{{ kit.nome }}{% endblock %}{% block body %}<link rel="stylesheet" href="{{ asset('styles/stock.css') }}?v=20260812-4"><div class="page-head"><div><a class="back-link" href="{{ path('app_kits_index') }}">← Kits</a><h1>{{ kit.nome }}</h1><p>{{ kit.descricao ?: 'Configure os materiais utilizados em cada unidade.' }}</p></div><a class="primary-btn" href="{{ path('app_kit_distribute') }}">Distribuir</a></div>{% for error in errors %}<div class="alert">{{ error }}</div>{% endfor %}<section class="kit-summary"><div><span>▣</span><p>Capacidade atual<strong>{{ capacity }} kits</strong></p></div><div><span>◫</span><p>Itens na composição<strong>{{ kit.componentes|length }} componentes</strong></p></div><div><span>✓</span><p>Situação<strong>{{ kit.ativo ? 'Kit ativo' : 'Kit inativo' }}</strong></p></div></section><div class="kit-builder-layout"><article class="panel"><div class="builder-head"><div><h3>Composição por kit</h3><p>Cada quantidade representa o consumo para montar uma unidade.</p></div></div><div class="kit-components">{% for component in kit.componentes %}<div class="kit-component"><div class="component-icon">{{ component.item.nome|slice(0,1)|upper }}</div><div class="component-name"><b>{{ component.item.nome }}</b><small>Saldo: {{ component.item.quantidade|number_format(3,',','.') }} {{ component.item.unidade }}</small></div><div class="component-quantity"><small>Por kit</small><strong>{{ component.quantidade|number_format(3,',','.') }} {{ component.item.unidade }}</strong></div><form method="post" action="{{ path('app_kit_component_delete',{kitId:kit.id,id:component.id}) }}" onsubmit="return confirm('Remover este componente do kit?')"><input type="hidden" name="_token" value="{{ csrf_token('kit-component-delete-'~component.id) }}"><button class="icon-action danger" title="Remover componente">×</button></form></div>{% else %}<div class="empty kit-empty"><span>□</span><h3>Kit sem componentes</h3><p>Use o formulário ao lado para adicionar o primeiro item.</p></div>{% endfor %}</div></article><aside><form method="post" class="panel kit-component-form"><input type="hidden" name="_token" value="{{ csrf_token('kit-component-'~kit.id) }}"><div class="field-builder-title"><span>＋</span><div><h3>Adicionar componente</h3><small>Item e consumo por kit</small></div></div><label>Item do estoque *<select name="item" required><option value="">Selecione...</option>{% for item in items %}<option value="{{ item.id }}">{{ item.nome }} — saldo {{ item.quantidade }} {{ item.unidade }}</option>{% endfor %}</select></label><label>Quantidade utilizada por kit *<input type="number" name="quantidade" min="0.001" step="0.001" value="1" required><small>Utilize a mesma unidade cadastrada no estoque.</small></label><button class="primary-btn">Adicionar à composição</button></form></aside></div>{% endblock %}
