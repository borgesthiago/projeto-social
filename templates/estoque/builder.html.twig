{% extends 'base.html.twig' %}{% block title %}{{ kit.nome }}{% endblock %}{% block body %}<link rel="stylesheet" href="{{ asset('styles/stock.css') }}"><div class="page-head"><div><a class="back-link" href="{{ path('app_kits_index') }}">← Kits</a><h1>{{ kit.nome }}</h1><p>O estoque atual permite montar <b>{{ capacity }} kit(s)</b>.</p></div><a class="primary-btn" href="{{ path('app_kit_distribute') }}">Distribuir</a></div>{% for error in errors %}<div class="alert">{{ error }}</div>{% endfor %}<div class="builder-layout"><article class="panel"><h3>Componentes por kit</h3><div class="kit-components">{% for component in kit.componentes %}<div class="kit-component"><span><b>{{ component.item.nome }}</b><small> · saldo {{ component.item.quantidade|number_format(3,',','.') }} {{ component.item.unidade }}</small></span><strong>{{ component.quantidade|number_format(3,',','.') }} {{ component.item.unidade }}</strong></div>{% else %}<div class="empty"><p>Adicione os itens usados em uma unidade deste kit.</p></div>{% endfor %}</div></article><form method="post" class="panel field-builder"><input type="hidden" name="_token" value="{{ csrf_token('kit-component-'~kit.id) }}"><h3>Adicionar componente</h3><label>Item<select name="item" required><option value="">Selecione...</option>{% for item in items %}<option value="{{ item.id }}">{{ item.nome }} — {{ item.quantidade }} {{ item.unidade }}</option>{% endfor %}</select></label><label>Quantidade por kit<input type="number" name="quantidade" min="0.001" step="0.001" value="1" required></label><button class="primary-btn">Adicionar</button></form></div>{% endblock %}
