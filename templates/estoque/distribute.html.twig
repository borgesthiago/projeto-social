{% extends 'base.html.twig' %}{% block title %}Distribuir kits{% endblock %}{% block body %}<link rel="stylesheet" href="{{ asset('styles/stock.css') }}"><div class="page-head"><div><a class="back-link" href="{{ path('app_stock_index') }}">← Estoque</a><h1>Distribuição de kits</h1><p>A quantidade é validada pelo público da turma ou da ação selecionada.</p></div><a class="secondary-btn" href="{{ path('app_kits_index') }}">Configurar kits</a></div>{% for error in errors %}<div class="alert">{{ error }}</div>{% endfor %}<form method="post" class="panel distribution-form"><input type="hidden" name="_token" value="{{ csrf_token('kit-distribute') }}"><label>Kit *<select name="kit" required><option value="">Selecione...</option>{% for kit in kits %}<option value="{{ kit.id }}">{{ kit.nome }}</option>{% endfor %}</select></label><label>Quantidade *<input type="number" name="quantidade" min="1" required></label><label>Turma <small>(escolha turma ou ação)</small><select name="turma"><option value="">Não selecionada</option>{% for class in classes %}<option value="{{ class.id }}">{{ class.nome }}</option>{% endfor %}</select></label><label>Ação/evento<select name="acao"><option value="">Não selecionada</option>{% for action in actions %}<option value="{{ action.id }}">{{ action.nome }} — {{ action.participantes }} participantes</option>{% endfor %}</select></label><label class="wide">Observações<textarea name="observacoes"></textarea></label><div class="form-actions wide"><button>Confirmar distribuição e dar baixa</button></div></form><article class="panel distribution-history"><h3>Histórico de distribuições</h3><div class="distribution-row"><b>Kit</b><b>Destino</b><b>Quantidade</b><b>Data</b></div>{% for item in distributions %}<div class="distribution-row"><span>{{ item.kit.nome }}</span><span>{{ item.turma ? 'Turma: '~item.turma.nome : 'Ação: '~item.acao.nome }}</span><b>{{ item.quantidade }}</b><span>{{ item.data|date('d/m/Y') }}</span></div>{% else %}<div class="empty"><p>Nenhuma distribuição registrada.</p></div>{% endfor %}</article>{% endblock %}
