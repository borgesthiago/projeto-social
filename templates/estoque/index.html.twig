{% extends 'base.html.twig' %}{% block title %}Estoque{% endblock %}{% block body %}<link rel="stylesheet" href="{{ asset('styles/stock.css') }}"><div class="page-head"><div><h1>▦ Controle de estoque</h1><p>Entradas, saídas e saldos dos materiais do projeto.</p></div><div class="stock-nav"><a class="secondary-btn" href="{{ path('app_kits_index') }}">▣ Kits</a><a class="primary-btn" href="{{ path('app_kit_distribute') }}">Distribuir kits</a></div></div>{% for error in errors %}<div class="alert">{{ error }}</div>{% endfor %}<details class="panel" open><summary><b>＋ Cadastrar item</b></summary><form method="post" class="distribution-form" style="margin-top:15px"><input type="hidden" name="_token" value="{{ csrf_token('stock-item') }}"><label>Item *<input name="nome" required></label><label>Unidade *<input name="unidade" placeholder="unidade, kg, pacote, rolo..." required></label><label>Categoria<input name="categoria"></label><label>Localização<input name="localizacao"></label><label>Estoque mínimo<input type="number" name="estoqueMinimo" value="0" min="0" step="0.001"></label><div class="form-actions wide"><button>Cadastrar item</button></div></form></details><div class="stock-grid">{% for item in items %}<article class="stock-card {{ item.quantidade<=item.estoqueMinimo?'low':'' }}"><header><div><h3>{{ item.nome }}</h3><small>{{ item.categoria ?: 'Sem categoria' }}</small></div><strong>{{ item.quantidade|number_format(3,',','.') }} <small>{{ item.unidade }}</small></strong></header><small>Estoque mínimo: {{ item.estoqueMinimo|number_format(3,',','.') }} · {{ item.localizacao ?: 'Local não informado' }}</small><form class="stock-move" method="post" action="{{ path('app_stock_move',{id:item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('stock-move-'~item.id) }}"><select name="tipo"><option value="entrada">Entrada</option><option value="saida">Saída avulsa</option><option value="ajuste">Ajustar saldo para</option></select><input type="number" name="quantidade" min="0.001" step="0.001" placeholder="Quantidade" required><input name="motivo" placeholder="Motivo / origem" required><button>Registrar</button></form></article>{% else %}<article class="panel empty"><p>Nenhum item cadastrado.</p></article>{% endfor %}</div>{% endblock %}
