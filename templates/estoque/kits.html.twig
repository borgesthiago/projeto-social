{% extends 'base.html.twig' %}{% block title %}Kits{% endblock %}{% block body %}<link rel="stylesheet" href="{{ asset('styles/stock.css') }}"><div class="page-head"><div><a class="back-link" href="{{ path('app_stock_index') }}">← Estoque</a><h1>Composição de kits</h1><p>Um kit pode representar lanche, material pedagógico, crochê ou qualquer outra entrega.</p></div><a class="primary-btn" href="{{ path('app_kit_distribute') }}">Distribuir kits</a></div>{% for error in errors %}<div class="alert">{{ error }}</div>{% endfor %}<form method="post" class="panel distribution-form"><input type="hidden" name="_token" value="{{ csrf_token('kit-new') }}"><label>Nome do kit *<input name="nome" placeholder="Ex.: Kit lanche" required></label><label>Descrição<input name="descricao"></label><div class="form-actions wide"><button>＋ Criar kit</button></div></form><div class="stock-grid">{% for kit in kits %}<article class="stock-card"><header><div><h3>{{ kit.nome }}</h3><p>{{ kit.descricao }}</p></div><strong>{{ capacity[kit.id] }} <small>possíveis</small></strong></header><p>{{ kit.componentes|length }} componente(s)</p><a class="secondary-btn" href="{{ path('app_kit_builder',{id:kit.id}) }}">Configurar composição</a></article>{% else %}<article class="panel empty"><p>Nenhum kit cadastrado.</p></article>{% endfor %}</div>{% endblock %}
