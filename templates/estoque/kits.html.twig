{% extends 'base.html.twig' %}{% block title %}Kits{% endblock %}{% block body %}<link rel="stylesheet" href="{{ asset('styles/stock.css') }}?v=20260812-4"><div class="page-head"><div><a class="back-link" href="{{ path('app_stock_index') }}">← Estoque</a><h1>Composição de kits</h1><p>Monte kits de lanche, material pedagógico, crochê ou outras entregas.</p></div><a class="primary-btn" href="{{ path('app_kit_distribute') }}">Distribuir kits</a></div>{% for error in errors %}<div class="alert">{{ error }}</div>{% endfor %}<section class="kit-create panel"><div class="kit-create-copy"><span>＋</span><div><h3>Criar novo kit</h3><p>Cadastre o kit e depois escolha os itens e quantidades que o compõem.</p></div></div><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('kit-new') }}"><label>Nome do kit *<input name="nome" placeholder="Ex.: Kit lanche" required></label><label>Descrição<input name="descricao" placeholder="Informe a finalidade do kit"></label><button class="primary-btn">Criar e montar kit</button></form></section><div class="kit-catalog-head"><div><h2>Kits cadastrados</h2><p>{{ kits|length }} configuração(ões)</p></div></div><div class="kit-grid">{% for kit in kits %}<article class="kit-card"><div class="kit-card-icon">▣</div><div class="kit-card-content"><header><div><h3>{{ kit.nome }}</h3><p>{{ kit.descricao ?: 'Sem descrição' }}</p></div><span class="kit-status">Ativo</span></header><div class="kit-card-metrics"><div><strong>{{ kit.componentes|length }}</strong><small>componentes</small></div><div><strong>{{ capacity[kit.id] }}</strong><small>kits possíveis</small></div></div><footer><a class="secondary-btn" href="{{ path('app_kit_builder',{id:kit.id}) }}">Configurar composição →</a></footer></div></article>{% else %}<article class="panel empty"><p>Nenhum kit cadastrado.</p></article>{% endfor %}</div>{% endblock %}
