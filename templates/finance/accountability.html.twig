{% extends 'base.html.twig' %}
{% block title %}Prestação de contas — {{ action.nome }}{% endblock %}
{% block body %}
<div class="page-head"><div><a class="back-link" href="{{ path('app_finance_index') }}">← Financeiro</a><h1>Prestação de contas</h1><p>{{ action.nome }} · {{ action.dataInicio|date('d/m/Y H:i') }} · {{ action.local }}</p></div><button class="secondary-btn" onclick="window.print()">⇩ Imprimir</button></div>
<div class="finance-totals"><article class="income"><small>Receitas vinculadas</small><strong>R$ {{ totals.receita|number_format(2,',','.') }}</strong></article><article class="expense"><small>Despesas vinculadas</small><strong>R$ {{ totals.despesa|number_format(2,',','.') }}</strong></article><article class="balance"><small>Saldo da ação</small><strong>R$ {{ (totals.receita-totals.despesa)|number_format(2,',','.') }}</strong></article></div>
<article class="panel"><h3>Profissionais e serviços contratados</h3><div class="finance-table"><div class="finance-row finance-header"><span>Profissional</span><span>Função</span><span>Situação</span><span>Período</span><span>Valor</span><span></span></div>{% for item in professionals %}<div class="finance-row"><span><b>{{ item.prestador.nome }}</b></span><span>{{ item.funcao }}</span><span>{{ item.situacao }}</span><span>{{ item.inicio ? item.inicio|date('d/m/Y H:i') : '—' }}</span><span>R$ {{ item.valorContratado|number_format(2,',','.') }}</span><span></span></div>{% else %}<div class="empty"><p>Nenhum profissional vinculado.</p></div>{% endfor %}</div><p><b>Total contratado:</b> R$ {{ totals.contratado|number_format(2,',','.') }}</p></article>
<article class="panel finance-history"><h3>Lançamentos e comprovantes</h3><div class="finance-table"><div class="finance-row finance-header"><span>Data</span><span>Descrição</span><span>Documento</span><span>Situação</span><span>Valor</span><span>Comprovante</span></div>{% for entry in entries %}<div class="finance-row"><span>{{ entry.data|date('d/m/Y') }}</span><span><b>{{ entry.descricao }}</b><small>{{ entry.prestador ? entry.prestador.nome : '' }}</small></span><span>{{ entry.numeroDocumento ?: '—' }}</span><span>{{ entry.situacao }}</span><span class="finance-value {{ entry.tipo }}">{{ entry.tipo=='despesa'?'-':'+' }} R$ {{ entry.valor|number_format(2,',','.') }}</span><span>{% if entry.comprovante %}<a href="{{ entry.comprovante }}" target="_blank">Abrir</a>{% else %}—{% endif %}</span></div>{% else %}<div class="empty"><p>Nenhum lançamento vinculado.</p></div>{% endfor %}</div></article>
{% endblock %}
