{% extends 'base.html.twig' %}
{% block title %}Gestão Financeira{% endblock %}
{% block body %}
<div class="page-head"><div><h1><span>$</span> Gestão Financeira</h1><p>Receitas, despesas, prestadores e prestação de contas das ações.</p></div><div class="page-actions"><a class="secondary-btn" href="{{ path('app_crud_index',{resource:'prestadores'}) }}">♟ Prestadores</a><a class="secondary-btn" href="{{ path('app_crud_index',{resource:'profissionais-acoes'}) }}">⇄ Profissionais por ação</a></div></div>
{% for error in errors %}<div class="alert">{{ error }}</div>{% endfor %}
<article class="panel finance-entry"><h3>Nova movimentação detalhada</h3><form method="post" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ csrf_token('finance-new') }}"><label>Tipo<select name="tipo"><option value="receita">Receita</option><option value="despesa" {{ app.request.request.get('tipo')=='despesa'?'selected':'' }}>Despesa</option></select></label><label>Categoria<input name="categoria" value="{{ app.request.request.get('categoria') }}" placeholder="Ex.: doação, alimentação"></label><label>Valor (R$)<input type="number" name="valor" value="{{ app.request.request.get('valor') }}" min="0.01" step="0.01" required></label><label class="finance-description">Descrição<input name="descricao" value="{{ app.request.request.get('descricao') }}" required></label><label>Data<input type="date" name="data" value="{{ app.request.request.get('data') ?: 'now'|date('Y-m-d') }}" required></label><label>Situação<select name="situacao"><option value="pago">Pago/recebido</option><option value="previsto">Previsto</option><option value="cancelado">Cancelado</option></select></label><label>Ação ou evento<select name="acao"><option value="">Geral do projeto</option>{% for action in actions %}<option value="{{ action.id }}">{{ action.nome }}</option>{% endfor %}</select></label><label>Prestador / profissional<select name="prestador"><option value="">Não vinculado</option>{% for provider in providers %}<option value="{{ provider.id }}">{{ provider.nome }} — {{ provider.especialidade }}</option>{% endfor %}</select></label><label>Nº nota, recibo ou contrato<input name="numeroDocumento" value="{{ app.request.request.get('numeroDocumento') }}"></label><details class="finance-receipt"><summary>Comprovante e transparência</summary><div><label>Enviar comprovante<input type="file" name="comprovanteArquivo" accept="application/pdf,image/jpeg,image/png,image/webp"><small>PDF, JPG, PNG ou WebP · máximo de 3 MB</small></label><label>Ou informar uma URL<input type="url" name="comprovanteUrl" value="{{ app.request.request.get('comprovanteUrl') }}" placeholder="https://..."></label><label class="check"><input type="checkbox" name="publica" value="1" checked> Exibir na transparência</label></div></details><div class="finance-form-actions"><button type="reset">× Cancelar</button><button type="submit">Salvar</button></div></form></article>
<div class="finance-totals"><article class="income"><small>Total de receitas</small><strong>R$ {{ totals.income|number_format(2,',','.') }}</strong><span>↗</span></article><article class="expense"><small>Total de despesas</small><strong>R$ {{ totals.expenses|number_format(2,',','.') }}</strong><span>↘</span></article><article class="balance"><small>Saldo atual</small><strong>R$ {{ totals.balance|number_format(2,',','.') }}</strong><span>$</span></article></div>
<article class="panel finance-history"><h3>Histórico de movimentações</h3><div class="finance-table"><div class="finance-row finance-header"><span>Data</span><span>Descrição</span><span>Categoria</span><span>Tipo</span><span>Valor</span><span>Ações</span></div>{% for entry in entries %}<div class="finance-row"><span>{{ entry.data|date('d/m/Y') }}</span><span><b>{{ entry.descricao }}</b><small>{% if entry.acao %}<a href="{{ path('app_finance_accountability',{id:entry.acao.id}) }}">{{ entry.acao.nome }}</a>{% endif %}{% if entry.prestador %} · {{ entry.prestador.nome }}{% endif %}{% if entry.comprovante %} · <a href="{{ entry.comprovante }}" target="_blank">Comprovante</a>{% endif %}</small></span><span><i class="finance-category">{{ entry.categoria ?: 'Sem categoria' }}</i></span><span><i class="finance-type {{ entry.tipo }}">{{ entry.tipo }} · {{ entry.situacao }}</i></span><span class="finance-value {{ entry.tipo }}">R$ {{ entry.valor|number_format(2,',','.') }}</span><span class="actions"><a class="icon-action" href="{{ path('app_crud_edit',{resource:'financeiro',id:entry.id}) }}">✎</a><form method="post" action="{{ path('app_crud_delete',{resource:'financeiro',id:entry.id}) }}" onsubmit="return confirm('Excluir esta movimentação?')"><input type="hidden" name="_token" value="{{ csrf_token('delete-financeiro-'~entry.id) }}"><button class="icon-action danger">×</button></form></span></div>{% else %}<div class="empty large"><h3>Nenhuma movimentação</h3></div>{% endfor %}</div></article>
{% endblock %}
