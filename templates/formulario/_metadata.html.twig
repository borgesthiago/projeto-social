<div class="form-grid"><label>Título *<input name="titulo" value="{{ form.titulo }}" required></label><label>Tipo *<select name="tipo"><option value="inscricao" {{ form.tipo=='inscricao'?'selected':'' }}>Inscrição</option><option value="avaliacao_evento" {{ form.tipo=='avaliacao_evento'?'selected':'' }}>Avaliação de evento</option><option value="avaliacao_aula" {{ form.tipo=='avaliacao_aula'?'selected':'' }}>Avaliação de aula</option><option value="pesquisa" {{ form.tipo=='pesquisa'?'selected':'' }}>Pesquisa</option></select></label><label>Ação/evento<select name="acao"><option value="">Não vinculado</option>{% for item in actions %}<option value="{{ item.id }}" {{ form.acao and form.acao.id==item.id?'selected':'' }}>{{ item.nome }}</option>{% endfor %}</select></label><label>Aula<select name="aula"><option value="">Não vinculada</option>{% for item in lessons %}<option value="{{ item.id }}" {{ form.aula and form.aula.id==item.id?'selected':'' }}>{{ item.titulo }} — {{ item.dataHora|date('d/m/Y') }}</option>{% endfor %}</select></label><label>Abertura<input type="datetime-local" name="abertura" value="{{ form.abertura ? form.abertura|date('Y-m-d\\TH:i') : '' }}"></label><label>Encerramento<input type="datetime-local" name="encerramento" value="{{ form.encerramento ? form.encerramento|date('Y-m-d\\TH:i') : '' }}"></label><label>Situação<select name="status"><option value="rascunho">Rascunho</option><option value="publicado" {{ form.status=='publicado'?'selected':'' }}>Publicado</option><option value="encerrado" {{ form.status=='encerrado'?'selected':'' }}>Encerrado</option></select></label><label class="wide">Descrição<textarea name="descricao">{{ form.descricao }}</textarea></label><label class="wide">Mensagem após o envio<textarea name="mensagemConfirmacao">{{ form.mensagemConfirmacao }}</textarea></label></div>
