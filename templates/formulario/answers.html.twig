{% extends 'base.html.twig' %}{% block title %}Respostas — {{ form.titulo }}{% endblock %}{% block body %}<link rel="stylesheet" href="{{ asset('styles/forms.css') }}"><div class="page-head"><div><a class="back-link" href="{{ path('app_forms_index') }}">← Formulários</a><h1>Respostas</h1><p>{{ form.titulo }} · {{ answers|length }} envio(s)</p></div><a class="secondary-btn" href="{{ path('app_forms_builder',{id:form.id}) }}">Editar formulário</a></div><div class="answers-table">{% for answer in answers %}<article class="answer-block"><header><div><b>{{ answer.nome ?: 'Resposta anônima' }}</b><small>{{ answer.email }}{% if answer.telefone %} · {{ answer.telefone }}{% endif %}</small></div><time>{{ answer.enviadoEm|date('d/m/Y H:i') }}</time></header><div class="answer-values">{% for field in form.campos %}<div><small>{{ field.rotulo }}</small><b>{% set value=answer.respostas[field.id~'']|default('—') %}{{ value is iterable ? value|join(', ') : value }}</b></div>{% endfor %}</div></article>{% else %}<article class="panel empty"><h3>Nenhuma resposta recebida</h3><p>Publique e compartilhe o formulário para começar.</p></article>{% endfor %}</div>{% endblock %}
