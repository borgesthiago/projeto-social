{% extends 'base.html.twig' %}{% block title %}Construtor — {{ form.titulo }}{% endblock %}{% block body %}<link rel="stylesheet" href="{{ asset('styles/forms.css') }}"><div class="page-head"><div><a class="back-link" href="{{ path('app_forms_index') }}">← Formulários</a><h1>Construtor do formulário</h1><p>{{ form.titulo }}</p></div>{% if form.status=='publicado' %}<a class="primary-btn" href="{{ path('app_public_form',{token:form.token}) }}" target="_blank">Abrir formulário público</a>{% endif %}</div>{% for error in errors %}<div class="alert">{{ error }}</div>{% endfor %}<div class="builder-layout"><div><form method="post" class="panel crud-form"><input type="hidden" name="_token" value="{{ csrf_token('form-builder-'~form.id) }}"><input type="hidden" name="operation" value="metadata">{% include 'formulario/_metadata.html.twig' %}<div class="form-actions"><button>Salvar configurações</button></div></form><article class="panel"><div class="builder-head"><h3>Perguntas</h3><b>{{ form.campos|length }}</b></div><div class="field-list">{% for field in form.campos %}<div class="field-card"><i>{{ loop.index }}</i><div><b>{{ field.rotulo }}{{ field.obrigatorio?' *':'' }}</b><small>{{ field.tipo|replace({'_':' '}) }}{% if field.opcoes %} · {{ field.opcoes|join(', ') }}{% endif %}</small></div><form method="post" action="{{ path('app_forms_field_delete',{formId:form.id,id:field.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('field-delete-'~field.id) }}"><button class="icon-action danger">×</button></form></div>{% else %}<div class="empty"><p>Adicione a primeira pergunta.</p></div>{% endfor %}</div></article></div><aside><form method="post" class="panel field-builder"><input type="hidden" name="_token" value="{{ csrf_token('form-builder-'~form.id) }}"><input type="hidden" name="operation" value="field"><h3>Adicionar pergunta</h3><label>Pergunta *<input name="rotulo" required></label><label>Tipo<select name="tipoCampo"><option value="texto">Texto curto</option><option value="texto_longo">Texto longo</option><option value="email">E-mail</option><option value="telefone">Telefone</option><option value="numero">Número</option><option value="data">Data</option><option value="selecao">Lista de seleção</option><option value="radio">Escolha única</option><option value="checkbox">Múltiplas escolhas</option><option value="nota">Nota de 1 a 5</option></select></label><label>Texto de ajuda<input name="ajuda"></label><label>Opções <small>(uma por linha)</small><textarea name="opcoes" rows="5"></textarea></label><label class="check"><input type="checkbox" name="obrigatorio"> Resposta obrigatória</label><button class="primary-btn">＋ Adicionar pergunta</button></form></aside></div>{% endblock %}
