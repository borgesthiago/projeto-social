{% extends 'base.html.twig' %}
{% block title %}Construtor — {{ form.titulo }}{% endblock %}
{% block body %}<link rel="stylesheet" href="{{ asset('styles/forms.css') }}?v=20260812-4">
<div class="page-head"><div><a class="back-link" href="{{ path('app_forms_index') }}">← Formulários</a><h1>Construtor do formulário</h1><p>{{ form.titulo }} · configure cada campo separadamente</p></div>{% if form.status == 'publicado' %}<a class="primary-btn" href="{{ path('app_public_form',{token:form.token}) }}" target="_blank">Abrir formulário público</a>{% endif %}</div>
{% for error in errors %}<div class="alert">{{ error }}</div>{% endfor %}{% for error in app.flashes('error') %}<div class="alert">{{ error }}</div>{% endfor %}
<div class="builder-layout"><div>
 <form method="post" class="panel crud-form"><input type="hidden" name="_token" value="{{ csrf_token('form-builder-'~form.id) }}"><input type="hidden" name="operation" value="metadata">{% include 'formulario/_metadata.html.twig' %}<div class="form-actions"><button>Salvar configurações</button></div></form>
 <article class="panel fields-panel"><div class="builder-head"><div><h3>Campos do formulário</h3><small>Ordem de exibição no formulário público</small></div><b>{{ form.campos|length }}</b></div><div class="field-list">{% for field in form.campos %}<div class="field-card"><i>{{ loop.index }}</i><div><b>{{ field.rotulo }}{{ field.obrigatorio ? ' *' : '' }}</b><small>{{ field.tipo|replace({'_':' '})|title }}{% if field.tamanho %} · máximo {{ field.tamanho }} caracteres{% endif %}{% if field.opcoes %} · {{ field.opcoes|join(', ') }}{% endif %}</small>{% if field.ajuda %}<em>{{ field.ajuda }}</em>{% endif %}</div><form method="post" action="{{ path('app_forms_field_delete',{formId:form.id,id:field.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('field-delete-'~field.id) }}"><button class="icon-action danger" title="Excluir campo">×</button></form></div>{% else %}<div class="empty"><p>Adicione o primeiro campo do formulário.</p></div>{% endfor %}</div></article>
</div><aside><form method="post" action="{{ path('app_forms_field_new',{id:form.id}) }}" class="panel field-builder"><input type="hidden" name="_token" value="{{ csrf_token('form-field-'~form.id) }}"><div class="field-builder-title"><span>＋</span><div><h3>Novo campo</h3><small>Um campo por vez</small></div></div><label>Nome do campo *<input name="rotulo" placeholder="Ex.: Nome completo" required></label><div class="field-config-grid"><label>Tipo *<select name="tipoCampo" data-field-type><option value="texto">Texto curto</option><option value="texto_longo">Texto longo</option><option value="email">E-mail</option><option value="telefone">Telefone</option><option value="numero">Número</option><option value="data">Data</option><option value="selecao">Lista de seleção</option><option value="radio">Escolha única</option><option value="checkbox">Múltiplas escolhas</option><option value="nota">Nota de 1 a 5</option></select></label><label data-size-field>Tamanho *<input type="number" name="tamanho" value="150" min="1" max="5000" required><small>Máximo de caracteres</small></label></div><label>Texto de ajuda<input name="ajuda" placeholder="Orientação exibida abaixo do campo"></label><label data-options-field>Opções <small>(uma por linha)</small><textarea name="opcoes" rows="5" placeholder="Opção 1&#10;Opção 2"></textarea></label><label class="required-toggle"><input type="checkbox" name="obrigatorio"><span><b>Campo obrigatório</b><small>O envio será bloqueado sem resposta</small></span></label><button class="primary-btn">Adicionar campo</button></form></aside></div>
<script>const type=document.querySelector('[data-field-type]'),size=document.querySelector('[data-size-field]'),options=document.querySelector('[data-options-field]');function toggleFieldConfig(){const value=type.value;size.hidden=!['texto','texto_longo','email','telefone'].includes(value);size.querySelector('input').disabled=size.hidden;options.hidden=!['selecao','radio','checkbox'].includes(value)}type.addEventListener('change',toggleFieldConfig);toggleFieldConfig()</script>
{% endblock %}
