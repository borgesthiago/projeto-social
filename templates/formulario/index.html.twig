{% extends 'base.html.twig' %}{% block title %}Formulários{% endblock %}{% block body %}<link rel="stylesheet" href="{{ asset('styles/forms.css') }}"><div class="page-head"><div><h1>▧ Formulários</h1><p>Crie inscrições, avaliações e pesquisas para ações e aulas.</p></div><a class="primary-btn" href="{{ path('app_forms_new') }}">＋ Novo formulário</a></div><div class="forms-grid">{% for form in forms %}<article class="form-card"><header><div><h2>{{ form.titulo }}</h2><small>{{ form.tipo|replace({'_':' '})|title }}</small></div><i class="badge {{ form.status=='publicado'?'ok':'off' }}">{{ form.status }}</i></header><p>{{ form.descricao ?: 'Sem descrição.' }}</p>{% if form.status=='publicado' %}<div class="form-link">{{ absolute_url(path('app_public_form',{token:form.token})) }}</div>{% endif %}<footer><b>{{ counts[form.id] }} resposta(s)</b><div><a class="secondary-btn" href="{{ path('app_forms_answers',{id:form.id}) }}">Respostas</a><a class="secondary-btn" href="{{ path('app_forms_builder',{id:form.id}) }}">Editar</a><form method="post" action="{{ path('app_forms_delete',{id:form.id}) }}" onsubmit="return confirm('Excluir formulário e respostas?')"><input type="hidden" name="_token" value="{{ csrf_token('form-delete-'~form.id) }}"><button class="icon-action danger">×</button></form></div></footer></article>{% else %}<article class="panel empty"><h3>Nenhum formulário</h3><p>Crie o primeiro formulário do projeto.</p></article>{% endfor %}</div>{% endblock %}
