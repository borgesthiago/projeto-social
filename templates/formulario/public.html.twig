{% extends 'base.html.twig' %}{% block title %}{{ form.titulo }}{% endblock %}{% block guest %}<link rel="stylesheet" href="{{ asset('styles/forms.css') }}"><main class="public-form-body"><section class="public-form">{% if sent %}<div class="public-success"><h1>✓ Resposta enviada</h1><p>{{ form.mensagemConfirmacao ?: 'Obrigado pela participação. Sua resposta foi registrada.' }}</p></div>{% else %}<header><small>{{ form.projeto.nome }}</small><h1>{{ form.titulo }}</h1><p>{{ form.descricao }}</p>{% if not form.disponivel %}<div class="alert">Este formulário não está recebendo respostas no momento.</div>{% endif %}</header>{% for error in errors %}<div class="alert">{{ error }}</div>{% endfor %}{% if form.disponivel %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('public-form-'~form.token) }}"><label>Nome<input name="nome" value="{{ app.request.request.get('nome') }}"></label><label>E-mail<input type="email" name="email" value="{{ app.request.request.get('email') }}"></label><label>Telefone<input name="telefone" value="{{ app.request.request.get('telefone') }}"></label>{% for field in form.campos %}<div class="public-question"><label>{{ field.rotulo }}{{ field.obrigatorio?' *':'' }}{% if field.ajuda %}<small>{{ field.ajuda }}</small>{% endif %}</label>{% if field.tipo=='texto_longo' %}<textarea name="campo[{{ field.id }}]" {{ field.obrigatorio?'required':'' }}></textarea>{% elseif field.tipo in ['selecao'] %}<select name="campo[{{ field.id }}]" {{ field.obrigatorio?'required':'' }}><option value="">Selecione...</option>{% for option in field.opcoes %}<option>{{ option }}</option>{% endfor %}</select>{% elseif field.tipo in ['radio','checkbox','nota'] %}<div class="public-options">{% set options=field.tipo=='nota' ? [1,2,3,4,5] : field.opcoes %}{% for option in options %}<label><input type="{{ field.tipo=='checkbox'?'checkbox':'radio' }}" name="campo[{{ field.id }}]{{ field.tipo=='checkbox'?'[]':'' }}" value="{{ option }}" {{ field.obrigatorio and field.tipo!='checkbox'?'required':'' }}> {{ option }}</label>{% endfor %}</div>{% else %}<input type="{{ field.tipo in ['email','numero','data'] ? (field.tipo=='numero'?'number':field.tipo) : 'text' }}" name="campo[{{ field.id }}]" {{ field.obrigatorio?'required':'' }}>{% endif %}</div>{% endfor %}<button class="primary-btn">Enviar resposta</button></form>{% endif %}{% endif %}</section></main>{% endblock %}
