{% extends 'base.html.twig' %}
{% block title %}Central de Ajuda{% endblock %}
{% macro card(icon,title,description,steps,keywords,href=null,label=null) %}<article class="help-card" data-help="{{ keywords }}"><div class="help-card-title"><span>{{ icon }}</span><div><h3>{{ title }}</h3><p>{{ description }}</p></div></div><ol>{% for step in steps %}<li>{{ step|raw }}</li>{% endfor %}</ol>{% if href %}<a href="{{ href }}">{{ label }} →</a>{% endif %}</article>{% endmacro %}
{% block body %}
<link rel="stylesheet" href="{{ asset('styles/help.css') }}?v=20260804-1">
<section class="help-hero"><div><span class="help-eyebrow">SUPORTE E ORIENTAÇÃO</span><h1>Como podemos ajudar?</h1><p>Conheça as funcionalidades e siga os passo a passo para aproveitar melhor o sistema.</p></div><label class="help-search"><span>⌕</span><input id="help-search" type="search" placeholder="Busque por aluno, frequência, turma..." autocomplete="off"></label></section>
{% set registrar=is_granted('ROLE_MASTER') or is_granted('ROLE_ADMINISTRATIVO') %}{% set chamada=(is_granted('ROLE_MASTER') or is_granted('ROLE_PROFESSOR')) and plan_feature('frequencia') %}{% set fila=registrar and plan_feature('fila_espera') %}{% set financeiro=(is_granted('ROLE_MASTER') or is_granted('ROLE_FINANCEIRO')) and plan_feature('financeiro') %}
<div class="help-layout"><aside class="help-topics"><strong>Nesta página</strong><a href="#inicio">🚀 Primeiros passos</a>{% if registrar %}<a href="#cadastros">♙ Cadastros</a>{% endif %}{% if plan_feature('gestao_turmas') %}<a href="#turmas">▦ Turmas e aulas</a>{% endif %}{% if chamada %}<a href="#frequencia">✓ Frequência</a>{% endif %}{% if fila %}<a href="#fila">≡ Fila de espera</a>{% endif %}{% if financeiro %}<a href="#financeiro">$ Financeiro</a>{% endif %}{% if is_granted('ROLE_MASTER') %}<a href="#administracao">⚙ Administração</a>{% endif %}</aside><div class="help-content"><div id="help-empty" class="help-empty" hidden><span>⌕</span><h2>Nenhum guia encontrado</h2><p>Tente buscar usando outra palavra.</p></div>
<section class="help-section" id="inicio"><header><span class="help-section-icon blue">🚀</span><div><h2>Primeiros passos</h2><p>Comece por aqui para se familiarizar com a plataforma.</p></div></header><div class="help-cards">{{ _self.card('⌂','Conheça a Visão geral','Acompanhe os principais números do projeto.',['Acesse <b>Visão geral</b> no menu lateral.','Confira os indicadores de alunos, turmas, aulas e fila.','Use os atalhos para chegar às tarefas frequentes.'],'dashboard indicadores painel') }}{{ _self.card('☰','Navegue pelo sistema','O menu exibe somente as funções do seu perfil e plano.',['Escolha um módulo no menu à esquerda.','No celular, toque em <b>☰</b> para abrir o menu.','Para encerrar com segurança, clique em <b>Sair</b>.'],'menu celular perfil sair') }}</div></section>
{% if registrar %}<section class="help-section" id="cadastros"><header><span class="help-section-icon green">♙</span><div><h2>Cadastros</h2><p>Mantenha as informações completas e atualizadas.</p></div></header><div class="help-cards">{% if plan_feature('gestao_alunos') %}{{ _self.card('＋','Cadastre um aluno','Registre os dados pessoais e o responsável.',['Acesse <b>Alunos</b> e clique em <b>Novo aluno</b>.','Preencha os dados e vincule um responsável, se necessário.','Revise e clique em <b>Salvar</b>.'],'aluno responsável documentos',path('app_crud_index',{resource:'alunos'}),'Ir para Alunos') }}{% endif %}{% if plan_feature('modalidades_cursos') %}{{ _self.card('▤','Crie modalidades e cursos','Organize as atividades antes de montar as turmas.',['Acesse <b>Modalidades e cursos</b>.','Clique em <b>Novo</b> e informe os dados.','Salve para usar a modalidade nas turmas.'],'modalidade curso cadastrar') }}{% endif %}</div></section>{% endif %}
{% if plan_feature('gestao_turmas') %}<section class="help-section" id="turmas"><header><span class="help-section-icon purple">▦</span><div><h2>Turmas e aulas</h2><p>Organize horários, participantes e atividades.</p></div></header><div class="help-cards">{{ _self.card('▦','Crie e organize uma turma','Defina modalidade, professor, capacidade e horários.',['Acesse <b>Turmas</b> e clique em <b>Nova turma</b>.','Informe os dados, o professor e o número de vagas.','Salve e abra a turma para matricular alunos.'],'turma professor matrícula vagas',path('app_turma_index'),'Ir para Turmas') }}{% if plan_feature('gestao_aulas') %}{{ _self.card('▣','Registre uma aula','Planeje data, horário e conteúdo.',['Acesse <b>Aulas</b> e escolha <b>Nova aula</b>.','Selecione a turma e informe os dados.','Salve; depois, registre a execução e a frequência.'],'aula agendar conteúdo',path('app_aula_index'),'Ir para Aulas') }}{% endif %}</div></section>{% endif %}
{% if chamada %}<section class="help-section" id="frequencia"><header><span class="help-section-icon orange">✓</span><div><h2>Frequência</h2><p>Faça a chamada e acompanhe a participação.</p></div></header><div class="help-cards">{{ _self.card('✓','Faça a chamada','Registre presença, falta ou atraso.',['Acesse <b>Frequência</b> e localize a aula.','Clique em <b>Fazer chamada</b> e marque cada aluno.','Confira a lista e salve.'],'chamada presença falta atraso',path('app_attendance_index'),'Ir para Frequência') }}</div></section>{% endif %}
{% if fila %}<section class="help-section" id="fila"><header><span class="help-section-icon orange">≡</span><div><h2>Fila de espera</h2><p>Organize a demanda por vagas.</p></div></header><div class="help-cards">{{ _self.card('≡','Gerencie a fila','Inclua interessados e acompanhe a classificação.',['Acesse <b>Fila de espera</b> e adicione o aluno.','Informe os critérios para calcular os pontos.','Ao surgir vaga, abra o registro e faça a matrícula.'],'fila prioridade pontuação vaga',path('app_waitlist_index'),'Ir para Fila de espera') }}</div></section>{% endif %}
{% if financeiro %}<section class="help-section" id="financeiro"><header><span class="help-section-icon green">$</span><div><h2>Financeiro</h2><p>Controle entradas, saídas e saldos.</p></div></header><div class="help-cards">{{ _self.card('$','Registre uma movimentação','Mantenha receitas e despesas organizadas.',['Acesse <b>Financeiro</b> e clique em <b>Nova movimentação</b>.','Escolha o tipo e preencha os dados.','Salve e confira os indicadores.'],'receita despesa pagamento saldo',path('app_finance_index'),'Ir para Financeiro') }}</div></section>{% endif %}
{% if is_granted('ROLE_MASTER') %}<section class="help-section" id="administracao"><header><span class="help-section-icon blue">⚙</span><div><h2>Administração</h2><p>Gerencie a equipe e personalize o sistema.</p></div></header><div class="help-cards">{{ _self.card('♙','Convide um usuário','Dê acesso à equipe com o perfil adequado.',['Acesse <b>Usuários</b> e clique em <b>Novo usuário</b>.','Informe nome, e-mail e perfis necessários.','Salve para enviar o convite.'],'usuário convite permissão',path('app_users_index'),'Ir para Usuários') }}{{ _self.card('⚙','Configure o projeto','Ajuste identidade, parâmetros e notificações.',['Acesse <b>Configurações</b> e escolha uma aba.','Altere os campos e revise os valores.','Clique em <b>Salvar</b> antes de mudar de aba.'],'configurações identidade notificações',path('app_settings'),'Ir para Configurações') }}</div></section>{% endif %}
</div></div><script src="{{ asset('scripts/help.js') }}?v=20260804-1"></script>
{% endblock %}
