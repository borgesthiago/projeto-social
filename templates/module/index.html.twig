{% extends 'base.html.twig' %}{% block body %}
{% set meta={
'usuarios':['♙','Gestão de Usuários','Gerencie usuários e suas permissões no sistema','Convidar Usuário'],
'turmas':['♙','Gestão de Turmas','Crie e gerencie as turmas, professores e alunos.','Nova Turma'],
'aulas':['▣','Gestão de Aulas','Cada aula é individual: Planejamento → Execução → Frequência','Nova Aula'],
'frequencia':['♧','Controle Geral de Frequência','Visualize e filtre os registros de presença de todos os alunos.',''],
'financeiro':['$','Gestão Financeira','Gerencie receitas, despesas e a saúde financeira do projeto.','Nova Movimentação'],
'alunos':['♢','Gestão de Alunos','Gerencie informações dos alunos, matrículas e desenvolvimento.','Novo Aluno'],
'responsaveis':['♙','Gestão de Responsáveis','Gerencie informações dos responsáveis pelos alunos.','Novo Responsável'],
'fila-espera':['◷','Fila de Espera','Gerencie a fila de espera para vagas nas turmas.','Novo na Fila'],
'relatorios':['⌁','Relatórios Gerais','Visualize dados e métricas consolidadas do projeto.',''],
'configuracoes':['⚙','Configurações do Sistema','Configure e personalize o funcionamento do sistema.',''],
'notificacoes':['▢','Central de Notificações','Envie mensagens WhatsApp para alunos e responsáveis','']
} %}{% set m=meta[slug]|default(['▤',title,'Gerencie as informações deste módulo.','Novo registro']) %}
<div class="page-head"><div><h1><span>{{ m[0] }}</span>{{ m[1] }}</h1><p>{{ m[2] }}</p></div>{% if m[3] %}<button>＋ {{ m[3] }}</button>{% endif %}</div>
{% if slug == 'turmas' %}<div class="class-grid">{% for card in [['J1',6,10],['N1',2,5],['A1',4,5]] %}<article class="panel class-card"><h2>{{ card[0] }} <small>◎　✎</small></h2><p>Sem descrição.</p><p>♙　Professor: A definir</p><label>♙　Lotação <b>{{ card[1] }} / {{ card[2] }}</b></label><progress value="{{ card[1] }}" max="{{ card[2] }}"></progress><div><button>♙ Alunos</button><button>▣ Relatório</button></div></article>{% endfor %}</div>
{% elseif slug in ['aulas','alunos','responsaveis','fila-espera'] %}{% set labels = slug=='aulas' ? ['Agendada','Em Andamento','Finalizada','Cancelada'] : (slug=='alunos' ? ['Ativo','Inativo','Fila Espera','Egresso'] : (slug=='responsaveis' ? ['Pais','Mães','Avós','Outros'] : ['J1','N1','A1','Outras'])) %}<div class="mini-stats">{% for label in labels %}<article><strong>0</strong><small>{{ label }}</small></article>{% endfor %}</div>{% if slug=='aulas' %}<div class="class-grid"><article class="panel lesson-card"><span>Em andamento</span><h3>As aulas aparecerão aqui</h3><p>Turma e professor responsável</p><p>▣ Planejado　✓ Frequência</p></article></div>{% else %}<article class="panel filters"><h3>▽ Filtros</h3><div class="toolbar"><input placeholder="Buscar por nome..."><select><option>Todos os Status</option></select><select><option>Todas as Turmas</option></select><button>× Limpar</button></div></article>{{ _self.table(title) }}{% endif %}
{% elseif slug=='financeiro' %}<div class="finance-stats"><article><small>Total de Receitas</small><strong>R$ 0,00</strong></article><article><small>Total de Despesas</small><strong>R$ 0,00</strong></article><article><small>Saldo Atual</small><strong>R$ 0,00</strong></article></div>{{ _self.table('Histórico de Movimentações') }}
{% elseif slug=='relatorios' %}<div class="mini-stats reports"><article><small>Total de Alunos</small><strong>0</strong></article><article><small>Total de Turmas</small><strong>0</strong></article><article><small>Frequência Média</small><strong>0%</strong></article><article><small>Saldo Financeiro</small><strong>R$ 0,00</strong></article></div><div class="grid"><article class="panel chart"><h3>Alunos por Status</h3><div>Sem dados</div></article><article class="panel chart"><h3>Visão Financeira</h3><div>Sem dados</div></article></div>
{% elseif slug=='configuracoes' %}<div class="tabs">{% for tab in ['Gerais','Educacionais','Qualificação','Notificações','Evolution API','Mensagens','Prioridades'] %}<button>{{ tab }}</button>{% endfor %}</div><article class="panel settings"><h3>Informações Gerais do Projeto</h3><p>Configure informações básicas, identidade visual e contatos</p><h3>Identidade Visual</h3><div class="upload-grid"><div>Logo do Projeto<br><b>PS</b><button>Escolher Logo</button></div><div>Banner do Sistema<br><span>Dia das Crianças Solidário</span><button>Escolher Banner</button></div></div></article>
{% elseif slug=='notificacoes' %}<div class="tabs"><button>Enviar Notificações</button><button>Histórico</button></div><article class="panel notify"><h3>Configurar Mensagem</h3><label>Tipo de Mensagem<select><option>Notificação de Falta</option><option>Notificação de Presença</option></select></label><div class="message-preview">Olá [Nome do Aluno]! Notamos sua ausência na aula.</div><h3>Destinatários <small>0 selecionados</small></h3><div class="toolbar"><select><option>Todas as Turmas</option></select><button>Selecionar Todos</button><button>Limpar</button></div></article>
{% else %}{{ _self.table(title) }}{% endif %}{% endblock %}
{% macro table(title) %}<article class="panel data-table"><h3>{{ title }}</h3><div class="table-head"><span>Nome / Descrição</span><span>Status</span><span>Informações</span><span>Ações</span></div><div class="empty"><p>Nenhum registro cadastrado.</p></div></article>{% endmacro %}
