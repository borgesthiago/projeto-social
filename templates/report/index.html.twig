{% extends 'base.html.twig' %}
{% block title %}Relatórios Gerais{% endblock %}
{% block body %}
<link rel="stylesheet" href="{{ asset('styles/report-indicators.css') }}?v=20260812-2">
<div class="page-head"><div><h1><span>⌁</span> Relatórios Gerais</h1><p>Visualize dados e métricas consolidadas do projeto.</p></div><button class="secondary-btn" type="button" onclick="window.print()">⇩ Exportar relatório</button></div>
<div class="report-metrics"><article class="students"><small>Total de alunos</small><strong>{{ metrics.students }}</strong><span>♢</span></article><article class="classes"><small>Total de turmas</small><strong>{{ metrics.classes }}</strong><span>♧</span></article><article class="attendance"><small>Frequência média</small><strong>{{ metrics.attendance|number_format(1,',','.') }}%</strong><span>⌁</span></article><article class="money"><small>Saldo financeiro</small><strong>R$ {{ metrics.balance|number_format(2,',','.') }}</strong><span>$</span></article></div>
<div class="report-charts"><article class="panel"><h3>Alunos por status</h3><div class="chart-wrap"><canvas id="students-chart" height="280"></canvas><div class="chart-legend" id="students-legend"></div></div></article><article class="panel"><h3>Visão financeira — últimos 6 meses</h3><div class="chart-wrap"><canvas id="finance-chart" height="280"></canvas><div class="chart-legend"><span><i style="background:#22c55e"></i>Receitas</span><span><i style="background:#ef4444"></i>Despesas</span></div></div></article></div>
<article class="panel class-performance"><h3>Desempenho das turmas</h3><div class="performance-row performance-header"><span>Turma</span><span>Modalidade</span><span>Professor</span><span>Lotação</span><span>Frequência média</span></div>{% for item in performance %}<div class="performance-row"><span><b>{{ item.class.nome }}</b></span><span>{{ item.class.modalidade.nome }}</span><span>{{ item.class.professor ? item.class.professor.nome : 'A definir' }}</span><span><i>{{ item.enrolled }} / {{ item.class.limiteAlunos }}</i></span><span><b>{{ item.attendance|number_format(1,',','.') }}%</b></span></div>{% else %}<div class="empty"><p>Nenhuma turma cadastrada.</p></div>{% endfor %}</article>
<section class="demographic-dashboard"><article class="panel indicator-chart-card"><header><span class="indicator-icon students">♙</span><div><h3>Sexo/gênero dos alunos</h3><p>Distribuição dos alunos cadastrados</p></div></header><canvas id="gender-students-chart" height="240"></canvas><div class="indicator-legend" id="gender-students-legend"></div></article><article class="panel indicator-chart-card"><header><span class="indicator-icon teachers">♟</span><div><h3>Sexo/gênero dos professores</h3><p>Distribuição da equipe docente</p></div></header><canvas id="gender-teachers-chart" height="240"></canvas><div class="indicator-legend" id="gender-teachers-legend"></div></article><article class="panel indicator-chart-card"><header><span class="indicator-icon ages">◷</span><div><h3>Faixa etária dos alunos</h3><p>Alunos por intervalo de idade</p></div></header><canvas id="age-students-chart" height="240"></canvas><div class="indicator-legend" id="age-students-legend"></div></article><article class="panel indicator-chart-card"><header><span class="indicator-icon ages teachers">◷</span><div><h3>Faixa etária dos professores</h3><p>Professores por intervalo de idade</p></div></header><canvas id="age-teachers-chart" height="240"></canvas><div class="indicator-legend" id="age-teachers-legend"></div></article></section>
<article class="panel ods-report"><div class="ods-report-head"><div><h3>Indicadores por ODS</h3><p>Contribuição do projeto para a Agenda 2030</p></div><a class="secondary-btn" href="{{ path('app_crud_index',{resource:'ods'}) }}">Gerenciar ODS</a></div><div class="ods-grid">{% for item in ods %}{% set total=item.actions+item.lessons+item.professionals %}<div class="ods-card {{ total?'has-data':'' }}"><span class="ods-number">{{ item.goal.numero }}</span><div><b>{{ item.goal.nome }}</b><div class="ods-metrics"><span><strong>{{ item.actions }}</strong> ações</span><span><strong>{{ item.lessons }}</strong> aulas</span><span><strong>{{ item.professionals }}</strong> profissionais</span></div></div></div>{% endfor %}</div></article>
<script>window.reportStudents={{ studentChart|json_encode|raw }};window.reportFinance={{ financeChart|json_encode|raw }};window.reportDemographics={{ {gender:gender,ages:ages}|json_encode|raw }};</script>
<script src="{{ asset('scripts/reports.js') }}?v=20260812-2"></script>
{% endblock %}
