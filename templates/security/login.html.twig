{% extends 'base.html.twig' %}{% block title %}Entrar | Projeto Social{% endblock %}{% block guest %}<div class="login-page"><div class="login-art"><div><span class="big-logo">PS</span><h1>Projeto Social</h1><p>Gestão que transforma. Impacto que permanece.</p></div></div><form method="post" class="login-card"><div><h2>Bem-vindo de volta</h2><p>Acesse os dados do seu projeto social</p></div>{% for message in app.flashes('success') %}<div class="success-alert">{{ message }}</div>{% endfor %}{% if error %}<div class="alert">{{ error.messageKey|trans(error.messageData,'security') }}</div>{% endif %}<label>E-mail<input type="email" name="_username" value="{{ last_username }}" required autofocus autocomplete="email" placeholder="voce@projeto.org"></label><label>Senha<input type="password" name="_password" required autocomplete="current-password" placeholder="••••••••"></label><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><button>Entrar</button><a class="register-link" href="{{ path('app_register') }}">Ainda não possui um projeto? Criar conta</a><small>Plataforma segura de gestão social</small></form></div>{% endblock %}
