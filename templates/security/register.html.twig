{% extends 'base.html.twig' %}{% block title %}Criar projeto | Projeto Social{% endblock %}{% block guest %}<div class="login-page"><div class="login-art"><div><span class="big-logo">PS</span><h1>Seu impacto começa aqui</h1><p>Crie o espaço seguro da sua organização.</p></div></div><form method="post" class="login-card register-card"><div><h2>Criar projeto social</h2><p>Você será o administrador da organização</p></div>{% for error in errors %}<div class="alert">{{ error }}</div>{% endfor %}<label>Nome do projeto<input name="projeto" required value="{{ app.request.request.get('projeto') }}" placeholder="Instituto Transformar"></label><label>CNPJ<input class="cnpj-mask" name="cnpj" required inputmode="numeric" maxlength="18" value="{{ app.request.request.get('cnpj') }}" placeholder="00.000.000/0000-00"></label><label>Seu nome<input name="nome" required value="{{ app.request.request.get('nome') }}" placeholder="Nome completo"></label><label>E-mail<input type="email" name="email" required value="{{ app.request.request.get('email') }}" autocomplete="email"></label><label>Senha<input type="password" name="password" required minlength="8" autocomplete="new-password" placeholder="Mínimo de 8 caracteres"></label><input type="hidden" name="_token" value="{{ csrf_token('register') }}"><button>Criar meu projeto</button><a class="register-link" href="{{ path('app_login') }}">Já tenho conta</a></form></div><script src="{{ asset('scripts/documents.js') }}"></script>{% endblock %}
