{% extends 'base.html.twig' %}{% block title %}Identidade Visual{% endblock %}{% block body %}<div class="page-head"><div><h1><span>✦</span>Identidade Visual</h1><p>Personalize a experiência de {{ project.nome }}.</p></div></div>{% for error in errors %}<div class="alert">{{ error }}</div>{% endfor %}<form method="post" enctype="multipart/form-data" class="identity-layout"><input type="hidden" name="_token" value="{{ csrf_token('identity-visual') }}"><article class="panel"><h3>Marca e imagens</h3><div class="visual-upload"><label>Logo do projeto <small>PNG, JPG ou WebP · até 1 MB</small><div class="upload-preview logo-preview">{% if project.logoPath %}<img src="{{ project.logoPath }}" alt="Logo">{% else %}<b>PS</b>{% endif %}</div><input type="file" name="logo" accept="image/png,image/jpeg,image/webp"></label>{% if project.logoPath %}<label class="remove-check"><input type="checkbox" name="remove_logo"> Remover logo atual</label>{% endif %}<label>Banner do topo <small>Recomendado: 1600 × 250 px · até 2 MB</small><div class="upload-preview banner-preview">{% if project.bannerPath %}<img src="{{ project.bannerPath }}" alt="Banner">{% else %}<span>Prévia do banner padrão</span>{% endif %}</div><input type="file" name="banner" accept="image/png,image/jpeg,image/webp"></label>{% if project.bannerPath %}<label class="remove-check"><input type="checkbox" name="remove_banner"> Remover banner atual</label>{% endif %}</div></article><article class="panel"><h3>Cores e comunicação</h3><div class="color-grid"><label>Cor primária<input type="color" name="corPrimaria" value="{{ project.corPrimaria }}"><code>{{ project.corPrimaria }}</code></label><label>Cor secundária<input type="color" name="corSecundaria" value="{{ project.corSecundaria }}"><code>{{ project.corSecundaria }}</code></label><label>Cor da sidebar<input type="color" name="corSidebar" value="{{ project.corSidebar }}"><code>{{ project.corSidebar }}</code></label><label>Texto dos botões<input type="color" name="corTextoBotao" value="{{ project.corTextoBotao }}"><code>{{ project.corTextoBotao }}</code></label></div><label class="slogan-field">Slogan institucional<input name="slogan" maxlength="160" value="{{ project.slogan }}" placeholder="Transformando vidas através da educação"></label><div class="theme-demo" style="--demo-a:{{ project.corPrimaria }};--demo-b:{{ project.corSecundaria }};--demo-text:{{ project.corTextoBotao }}"><span>Prévia</span><button type="button">Botão principal</button></div></article><div class="identity-actions"><button>Salvar personalização</button></div></form>{% endblock %}
