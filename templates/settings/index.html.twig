{% extends 'base.html.twig' %}
{% block title %}Configurações do Sistema{% endblock %}
{% block body %}
<style>@import url('{{ asset('styles/settings.css') }}');</style>
<div class="page-head"><div><h1><span>⚙</span> Configurações do Sistema</h1><p>Configure e personalize o funcionamento do sistema.</p></div></div>
<nav class="settings-tabs">{% for key,label in {'gerais':'ⓘ Gerais','educacionais':'▣ Educacionais','qualificacao':'♙ Qualificação','notificacoes':'♧ Notificações','evolution':'▢ Evolution API','mensagens':'▢ Mensagens','prioridades':'$ Prioridades'} %}{% if key!='evolution' or evolutionEnabled %}<a class="{{ tab==key?'active':'' }}" href="{{ path('app_settings',{tab:key}) }}">{{ label }}</a>{% endif %}{% endfor %}</nav>
{% for error in errors %}<div class="alert">{{ error }}</div>{% endfor %}
{% if tab=='gerais' %}<form method="post" enctype="multipart/form-data" class="panel settings-panel"><input type="hidden" name="_token" value="{{ csrf_token('settings-gerais') }}"><h3>Informações gerais do projeto</h3><p>Configure informações básicas, identidade visual e contatos.</p>{% if identityEnabled %}<h2>Identidade visual</h2><div class="settings-visual-grid"><label>Logo do projeto<div class="settings-upload-preview logo">{% if project.logoPath %}<img src="{{ project.logoPath }}" alt="Logo atual">{% else %}<b>PS</b>{% endif %}</div><input type="file" name="logo" accept="image/jpeg,image/png,image/webp"><small>PNG, JPG ou WebP · até 1 MB</small>{% if project.logoPath %}<span><input type="checkbox" name="remove_logo"> Remover atual</span>{% endif %}</label><label>Banner do sistema<div class="settings-upload-preview banner">{% if project.bannerPath %}<img src="{{ project.bannerPath }}" alt="Banner atual">{% else %}<b>Banner padrão</b>{% endif %}</div><input type="file" name="banner" accept="image/jpeg,image/png,image/webp"><small>Recomendado 1600 × 250 px · até 2 MB</small>{% if project.bannerPath %}<span><input type="checkbox" name="remove_banner"> Remover atual</span>{% endif %}</label></div>{% endif %}<h2>Informações básicas</h2><div class="settings-form-grid"><label>Nome do projeto *<input name="nome" value="{{ project.nome }}" required></label><label>E-mail de contato<input type="email" name="email" value="{{ project.email }}"></label><label>Telefone de contato<input name="telefone" value="{{ project.telefone }}"></label><label>Endereço<input name="endereco" value="{{ values.endereco|default('') }}"></label><label>Slogan<input name="slogan" value="{{ project.slogan }}"></label><label class="wide">Descrição do projeto<textarea name="descricao" rows="4">{{ values.descricao|default('') }}</textarea></label></div><div class="settings-actions"><button>▣ Salvar configurações gerais</button></div></form>
{% elseif tab=='educacionais' %}<form method="post" class="panel settings-panel"><input type="hidden" name="_token" value="{{ csrf_token('settings-educacionais') }}"><h3>Parâmetros educacionais</h3><p>Defina critérios para o funcionamento pedagógico.</p><div class="settings-form-grid three"><label>Frequência mínima (%)<input type="number" min="0" max="100" name="frequencia_minima" value="{{ values.frequencia_minima|default(75) }}"><small>Porcentagem mínima de presença exigida</small></label><label>Aulas mínimas por mês<input type="number" min="0" name="aulas_minimas_mes" value="{{ values.aulas_minimas_mes|default(8) }}"><small>Número mínimo esperado de aulas</small></label><label>Tolerância de atraso (min)<input type="number" min="0" name="tolerancia_atraso" value="{{ values.tolerancia_atraso|default(15) }}"><small>Minutos de tolerância para atrasos</small></label></div><div class="settings-actions"><button>▣ Salvar parâmetros educacionais</button></div></form>
{% elseif tab=='qualificacao' %}<form method="post" class="panel settings-panel"><input type="hidden" name="_token" value="{{ csrf_token('settings-qualificacao') }}"><h3>Qualificação da completude cadastral</h3><p>Este nível mede somente quantas informações do aluno e de seu responsável estão preenchidas. Ele não é perfil de acesso e não concede permissões no sistema.</p><div class="qualification-summary">{% for level,total in levels %}<article class="qualification-level {{ level|lower }}"><strong>{{ total }}</strong><small>{{ level }}</small></article>{% endfor %}</div><h2>Faixas de completude</h2><div class="settings-form-grid qualification-thresholds"><label>Bronze a partir de (%)<input type="number" name="bronze" min="1" max="100" value="{{ thresholds.bronze }}" required><small>Cadastro inicial, ainda com informações pendentes.</small></label><label>Prata a partir de (%)<input type="number" name="prata" min="1" max="100" value="{{ thresholds.prata }}" required><small>Cadastro intermediário, com a maior parte dos dados.</small></label><label>Ouro a partir de (%)<input type="number" name="ouro" min="1" max="100" value="{{ thresholds.ouro }}" required><small>Cadastro completo ou quase completo.</small></label></div><div class="settings-info"><h3>O que entra no cálculo?</h3><p>Nome, nascimento, CPF, telefone e situação do aluno. Para menores de idade — ou quando houver vínculo — também entram responsável, nome, CPF, telefone e e-mail do responsável.</p><p><b>Não confundir:</b> os pontos dos critérios de prioridade são independentes e servem exclusivamente para ordenar a fila de espera.</p></div><div class="settings-actions"><button>▣ Salvar faixas de qualificação</button></div></form>
{% elseif tab=='notificacoes' %}<form method="post" class="panel settings-panel"><input type="hidden" name="_token" value="{{ csrf_token('settings-notificacoes') }}"><h3>Configurações de notificações</h3><p>Defina quando o sistema deve notificar usuários.</p><div class="toggle-list">{% for notification in [['notificar_faltas','Notificar faltas','Enviar notificação quando um aluno faltar'],['notificar_pagamento','Notificar atraso de pagamento','Alertar sobre pagamentos atrasados'],['notificar_vaga','Notificar vaga disponível','Avisar pessoas da fila quando abrir vaga']] %}{% set key=notification[0] %}<label><span><b>{{ notification[1] }}</b><small>{{ notification[2] }}</small></span><input type="checkbox" name="{{ key }}" value="1" {{ values[key]|default('0')=='1'?'checked':'' }}></label>{% endfor %}</div><label>Dias de antecedência para notificações<input type="number" min="0" name="antecedencia_dias" value="{{ values.antecedencia_dias|default(3) }}"></label><div class="settings-actions"><button>▣ Salvar configurações de notificações</button></div></form>
{% elseif tab=='evolution' %}<form method="post" class="panel settings-panel"><input type="hidden" name="_token" value="{{ csrf_token('settings-evolution') }}"><h3>Configurações da Evolution API</h3><p>Configure a integração para envio de mensagens WhatsApp.</p><div class="settings-form-grid"><label class="wide">URL da API<input type="url" name="evolution_url" value="{{ values.evolution_url|default('') }}" placeholder="https://evolution.exemplo.com"></label><label class="wide">API Token<input type="password" name="evolution_token" value="{{ values.evolution_token|default('') }}"></label><label class="wide">Nome da instância<input name="evolution_instancia" value="{{ values.evolution_instancia|default('') }}"></label></div><div class="development-box"><label><span><b>Modo de desenvolvimento</b><small>Direciona todas as mensagens para o celular de teste</small></span><input type="checkbox" name="evolution_dev" value="1" {{ values.evolution_dev|default('0')=='1'?'checked':'' }}></label><input name="evolution_celular_teste" value="{{ values.evolution_celular_teste|default('') }}" placeholder="Celular para testes"></div><div class="settings-actions"><button>▣ Salvar Evolution API</button></div></form>
{% elseif tab=='mensagens' %}<form method="post" class="panel settings-panel"><input type="hidden" name="_token" value="{{ csrf_token('settings-mensagens') }}"><h3>Mensagens padronizadas</h3><p>Personalize as mensagens automáticas enviadas pelo sistema.</p><div class="variables-box"><b>Variáveis disponíveis:</b><span>{nome}</span><span>{turma}</span><span>{data}</span><span>{hora}</span></div>{% set messages={'mensagem_falta':['Mensagem de falta','Olá {nome}! Notamos sua ausência na aula de {data}.'], 'mensagem_presenca':['Mensagem de presença','Olá {nome}! Obrigado por comparecer à aula de {data}.'], 'mensagem_vaga':['Mensagem de vaga disponível','Olá {nome}! Temos uma vaga disponível na turma {turma}.'], 'mensagem_matricula':['Mensagem de matrícula confirmada','Parabéns {nome}! Sua matrícula foi confirmada na turma {turma}.'], 'mensagem_pagamento':['Mensagem de atraso de pagamento','Olá {nome}! Identificamos um atraso no pagamento.'] } %}{% for key,item in messages %}<label>{{ item[0] }}<textarea name="{{ key }}" rows="3">{{ values[key]|default(item[1]) }}</textarea></label>{% endfor %}<div class="settings-actions"><button>▣ Salvar mensagens padronizadas</button></div></form>
{% else %}<article class="panel settings-panel"><div class="settings-priority-head"><div><h3>Prioridades da fila de espera</h3><p>Configure os critérios de pontuação aplicados aos alunos.</p></div><a class="primary-btn" href="{{ path('app_crud_new',{resource:'prioridades'}) }}">＋ Nova prioridade</a></div><div class="settings-priority-table"><div class="priority-row priority-header"><span>Descrição</span><span>Pontos</span><span>Status</span><span>Comprovação</span><span>Ações</span></div>{% for priority in priorities %}<div class="priority-row"><span><b>{{ priority.nome }}</b></span><span><i>{{ priority.pontos }} pts</i></span><span><i class="badge {{ priority.ativa?'ok':'off' }}">{{ priority.ativa?'Ativo':'Inativo' }}</i></span><span>{{ priority.descricao ?: (priority.exigeComprovante?'Comprovante obrigatório':'Não exige comprovante') }}</span><span class="actions"><a class="icon-action" href="{{ path('app_crud_edit',{resource:'prioridades',id:priority.id}) }}" title="Editar">✎</a><form method="post" action="{{ path('app_crud_delete',{resource:'prioridades',id:priority.id}) }}" onsubmit="return confirm('Excluir este critério?')"><input type="hidden" name="_token" value="{{ csrf_token('delete-prioridades-'~priority.id) }}"><button class="icon-action danger" title="Excluir">×</button></form></span></div>{% else %}<div class="empty"><p>Nenhum critério cadastrado.</p></div>{% endfor %}</div></article>{% endif %}
{% endblock %}
