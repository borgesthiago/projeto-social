<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{% block title %}Super Admin{% endblock %} | Projeto Social</title><link rel="stylesheet" href="{{ asset('styles/app.css') }}"><link rel="stylesheet" href="{{ asset('styles/activity.css') }}"></head><body class="super-body"><aside class="super-sidebar"><a class="brand" href="{{ path('app_superadmin_index') }}"><span>PS</span><div>Projeto Social<small>Administração SaaS</small></div></a><nav><a href="{{ path('app_superadmin_index') }}"><b>⌂</b>Organizações</a><a href="{{ path('app_superadmin_plans') }}"><b>▦</b>Planos</a><a href="{{ path('app_superadmin_subscriptions') }}"><b>↻</b>Assinaturas</a><a href="{{ path('app_superadmin_payments') }}"><b>$</b>Financeiro SaaS</a></nav><div class="profile"><div class="avatar">{{ app.user.nome|slice(0,1)|upper }}</div><div>{{ app.user.nome }}<small>Super Admin</small></div><a href="{{ path('app_logout') }}">Sair</a></div></aside><main class="super-main"><header><div><strong>Central da Plataforma</strong><small>Administração global do SaaS</small></div></header><section class="content">{% for type,messages in app.flashes %}{% for message in messages %}<div class="{{ type=='success'?'success-alert':'alert' }}">{{ message }}</div>{% endfor %}{% endfor %}{% block body %}{% endblock %}</section></main><script src="{{ asset('scripts/activity.js') }}"></script></body></html>
