{% extends 'superadmin/base.html.twig' %}{% block body %}<div class="page-head"><div><h1><span>◆</span>Projetos Sociais</h1><p>Gerencie todas as organizações cadastradas na plataforma.</p></div><a class="primary-btn" href="{{ path('app_superadmin_project_new') }}">＋ Nova ONG</a></div><div class="mini-stats super-stats"><article><strong>{{ projects|length }}</strong><small>Projetos cadastrados</small></article><article><strong>{{ projects|filter(p=>p.ativo)|length }}</strong><small>Projetos ativos</small></article><article><strong>{{ totalUsers }}</strong><small>Usuários da plataforma</small></article></div><div class="tenant-grid">{% for project in projects %}{% set subscription=stats[project.id].subscription %}<article class="panel tenant-card"><div class="tenant-card-head"><div class="tenant-logo">{{ project.nome|slice(0,2)|upper }}</div><div><h2>{{ project.nome }}</h2><small>{{ project.slug }}</small></div><i class="badge {{ project.ativo and subscription and subscription.acessoLiberado?'ok':'off' }}">{{ not project.ativo?'Suspenso':(subscription?subscription.status:'Sem assinatura') }}</i></div><div class="tenant-metrics"><span><b>{{ stats[project.id].users }}</b> usuários</span><span><b>{{ stats[project.id].students }}</b> alunos</span><span>{% if subscription %}{{ subscription.plano.nome }}<br>até {{ subscription.vencimento|date('d/m/Y') }}{% else %}Sem plano{% endif %}</span></div><div class="tenant-actions"><a class="details-btn" href="{{ path('app_superadmin_project_details',{id:project.id}) }}">Detalhes</a><a href="{{ path('app_superadmin_project',{id:project.id}) }}">Gerenciar</a><form method="post" action="{{ path('app_superadmin_project_status',{id:project.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('status-'~project.id) }}"><button class="{{ project.ativo?'danger-btn':'' }}">{{ project.ativo?'Suspender':'Ativar' }}</button></form></div></article>{% else %}<article class="panel empty large"><h3>Nenhuma ONG cadastrada</h3><p>Cadastre a primeira organização e seu usuário Master.</p></article>{% endfor %}</div>{% endblock %}
