{% extends 'superadmin/base.html.twig' %}{% block title %}Nova ONG{% endblock %}{% block body %}<div class="page-head"><div><a class="back-link" href="{{ path('app_superadmin_index') }}">← Organizações</a><h1>Nova ONG</h1><p>Crie a organização, assinatura e primeiro usuário Master.</p></div></div>{% for error in errors %}<div class="alert">{{ error }}</div>{% endfor %}<form method="post" class="panel crud-form"><input type="hidden" name="_token" value="{{ csrf_token('new-project') }}"><div class="form-grid"><label>Nome da ONG *<input name="nome" required value="{{ app.request.request.get('nome') }}"></label><label>CNPJ *<input class="cnpj-mask" name="cnpj" required inputmode="numeric" maxlength="18" value="{{ app.request.request.get('cnpj') }}" placeholder="00.000.000/0000-00"></label><label>Plano *<select name="plano" required>{% for plan in plans %}<option value="{{ plan.id }}">{{ plan.nome }} — R$ {{ plan.valorMensal|number_format(2,',','.') }}</option>{% endfor %}</select></label><label>Responsável Master *<input name="owner" required value="{{ app.request.request.get('owner') }}"></label><label>E-mail de acesso *<input type="email" name="email" required value="{{ app.request.request.get('email') }}"></label><label>Senha inicial *<input type="password" name="password" required minlength="8"></label></div><div class="form-actions"><a href="{{ path('app_superadmin_index') }}">Cancelar</a><button>Criar ONG e liberar acesso</button></div></form><script src="{{ asset('scripts/documents.js') }}"></script>{% endblock %}
