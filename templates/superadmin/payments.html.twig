{% extends 'superadmin/base.html.twig' %}{% block title %}Financeiro SaaS{% endblock %}{% block body %}<div class="page-head"><div><h1>Financeiro SaaS</h1><p>Registre cobranças e confirme pagamentos das organizações.</p></div></div><form method="post" class="panel billing-inline payment-form"><input type="hidden" name="_token" value="{{ csrf_token('payment-form') }}"><select name="assinatura" required>{% for item in subscriptions %}<option value="{{ item.id }}">{{ item.projeto.nome }} — {{ item.plano.nome }}</option>{% endfor %}</select><input type="number" step="0.01" min="0" name="valor" placeholder="Valor" required><input type="date" name="vencimento" value="{{ 'now'|date_modify('+30 days')|date('Y-m-d') }}" required><input name="metodo" placeholder="Método"><input name="referencia" placeholder="Referência"><button>Gerar cobrança</button></form><article class="panel data-table"><div class="crud-row payment-row crud-header"><span>ONG</span><span>Valor</span><span>Vencimento</span><span>Status</span><span>Pagamento</span><span>Ações</span></div>{% for payment in payments %}<div class="crud-row payment-row"><span>{{ payment.assinatura.projeto.nome }}</span><span>R$ {{ payment.valor|number_format(2,',','.') }}</span><span>{{ payment.vencimento|date('d/m/Y') }}</span><span><i class="badge {{ payment.status=='pago'?'ok':'off' }}">{{ payment.status }}</i></span><span>{{ payment.pagoEm?payment.pagoEm|date('d/m/Y H:i'):'—' }}</span><span>{% if payment.status!='pago' %}<form method="post" action="{{ path('app_superadmin_payment_paid',{id:payment.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('paid-'~payment.id) }}"><button class="pay-btn">Confirmar pagamento</button></form>{% endif %}</span></div>{% else %}<div class="empty">Nenhuma cobrança registrada.</div>{% endfor %}</article>{% endblock %}
