{% extends 'superadmin/base.html.twig' %}{% block body %}<div class="page-head"><div><a class="back-link" href="{{ path('app_superadmin_plans') }}">← Planos</a><h1>Editar {{ plan.nome }}</h1><p>Alterações de funcionalidades e cotas valem imediatamente para as ONGs deste plano.</p></div></div><form method="post" class="panel crud-form wide-plan"><input type="hidden" name="_token" value="{{ csrf_token('plan-'~plan.id) }}"><div class="form-grid"><label>Nome<input name="nome" value="{{ plan.nome }}" required></label><label>Valor mensal<input type="number" step="0.01" min="0" name="valorMensal" value="{{ plan.valorMensal }}" required></label><label>Limite de usuários<input type="number" min="1" name="limiteUsuarios" value="{{ plan.limiteUsuarios }}" required></label><label>Limite de turmas<input type="number" min="1" name="limiteTurmas" value="{{ plan.limiteTurmas }}" required></label><label>Limite de alunos <small>(vazio = ilimitado)</small><input type="number" min="1" name="limiteAlunos" value="{{ plan.limiteAlunos }}"></label><label>Notificações/mês <small>(vazio = ilimitado)</small><input type="number" min="0" name="limiteNotificacoesMes" value="{{ plan.limiteNotificacoesMes }}"></label><label>Armazenamento em MB<input type="number" min="100" name="limiteArmazenamentoMb" value="{{ plan.limiteArmazenamentoMb }}"></label><label>Dias de teste<input type="number" min="0" name="diasTeste" value="{{ plan.diasTeste }}"></label></div><h3>Funcionalidades</h3><div class="checkbox-grid">{% for key,label in features %}<label><input type="checkbox" name="recursos[]" value="{{ key }}" {{ key in plan.recursos or 'todos' in plan.recursos?'checked':'' }}> <span>{{ label }}</span></label>{% endfor %}</div><h3>Canais de notificação</h3><div class="checkbox-grid channels">{% for key,label in channels %}<label><input type="checkbox" name="canais[]" value="{{ key }}" {{ key in plan.canaisNotificacao?'checked':'' }}> <span>{{ label }}</span></label>{% endfor %}</div><div class="plan-flags"><label><input type="checkbox" name="ativo" {{ plan.ativo?'checked':'' }}> Plano ativo</label><label><input type="checkbox" name="publico" {{ plan.publico?'checked':'' }}> Cadastro público</label></div><div class="form-actions"><button>Salvar plano</button></div></form>{% endblock %}
