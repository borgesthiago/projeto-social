{% extends 'superadmin/base.html.twig' %}{% block title %}Planos{% endblock %}{% block body %}<div class="page-head"><div><h1>Planos</h1><p>Defina funcionalidades, canais e limites de cada oferta.</p></div></div><details class="panel plan-builder"><summary>＋ Criar novo plano</summary><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('plan-form') }}"><div class="form-grid"><label>Nome<input name="nome" required></label><label>Valor mensal<input type="number" step="0.01" min="0" name="valorMensal" required></label><label>Limite de usuários<input type="number" min="1" name="limiteUsuarios" value="5" required></label><label>Limite de turmas<input type="number" min="1" name="limiteTurmas" value="5" required></label><label>Limite de alunos <small>(vazio = ilimitado)</small><input type="number" min="1" name="limiteAlunos"></label><label>Notificações por mês <small>(vazio = ilimitado)</small><input type="number" min="0" name="limiteNotificacoesMes" value="500"></label><label>Armazenamento em MB<input type="number" min="100" name="limiteArmazenamentoMb" value="1024"></label><label>Dias de teste<input type="number" min="0" name="diasTeste" value="14"></label></div><h3>Funcionalidades incluídas</h3><div class="checkbox-grid">{% for key,label in features %}<label><input type="checkbox" name="recursos[]" value="{{ key }}"> <span>{{ label }}</span></label>{% endfor %}</div><h3>Canais de notificação</h3><div class="checkbox-grid channels">{% for key,label in channels %}<label><input type="checkbox" name="canais[]" value="{{ key }}"> <span>{{ label }}</span></label>{% endfor %}</div><div class="plan-flags"><label><input type="checkbox" name="ativo" checked> Plano ativo</label><label><input type="checkbox" name="publico" checked> Disponível no cadastro público</label></div><div class="form-actions"><button>Criar plano</button></div></form></details><div class="tenant-grid billing-grid">{% for plan in plans %}<article class="panel plan-card"><i class="badge {{ plan.ativo?'ok':'off' }}">{{ plan.ativo?'Ativo':'Inativo' }}</i><h2>{{ plan.nome }}</h2><strong>R$ {{ plan.valorMensal|number_format(2,',','.') }}<small>/mês</small></strong><div class="plan-limits"><span>{{ plan.limiteUsuarios }} usuários</span><span>{{ plan.limiteTurmas }} turmas</span><span>{{ plan.limiteAlunos??'∞' }} alunos</span><span>{{ plan.limiteNotificacoesMes??'∞' }} notificações/mês</span></div><p>{{ plan.recursos|length }} funcionalidades · {{ plan.canaisNotificacao|join(', ')|default('sem canais') }}</p><a href="{{ path('app_superadmin_plan_edit',{id:plan.id}) }}">Editar configurações</a></article>{% endfor %}</div>{% endblock %}
