{% extends 'superadmin/base.html.twig' %}
{% block title %}{{ project.nome }}{% endblock %}
{% block body %}
<link rel="stylesheet" href="{{ asset('styles/superadmin-project.css') }}?v=20260804-1">
<div class="page-head"><div><a class="back-link" href="{{ path('app_superadmin_index') }}">← Organizações</a><h1>{{ project.nome }}</h1><p>CNPJ {{ project.cnpj|default('não informado') }} · {{ project.slug }}</p></div>{% if subscription %}<a class="primary-btn" href="{{ path('app_superadmin_subscription_edit',{id:subscription.id}) }}">Gerenciar assinatura</a>{% endif %}</div>
{% if subscription %}<div class="subscription-summary"><span>Plano <b>{{ subscription.plano.nome }}</b></span><span>Status <b>{{ subscription.status|capitalize }}</b></span><span>Vencimento <b>{{ subscription.vencimento|date('d/m/Y') }}</b></span><span>Acesso <b>{{ subscription.acessoLiberado?'Liberado':'Bloqueado' }}</b></span></div>{% endif %}
<section class="org-kpis"><article><i>♙</i><span>Alunos<strong>{{ stats.students }}</strong><small>{{ stats.activeStudents }} ativos</small></span></article><article><i>♟</i><span>Professores<strong>{{ stats.teachers }}</strong><small>cadastrados</small></span></article><article><i>♧</i><span>Responsáveis<strong>{{ stats.responsibles }}</strong><small>cadastrados</small></span></article><article><i>▦</i><span>Turmas<strong>{{ stats.classes }}</strong><small>{{ stats.activeClasses }} ativas</small></span></article><article><i>▣</i><span>Aulas<strong>{{ stats.lessons }}</strong><small>registradas</small></span></article><article><i>♙</i><span>Usuários<strong>{{ stats.users }}</strong><small>{{ stats.activeUsers }} ativos</small></span></article><article><i>▤</i><span>Modalidades<strong>{{ stats.modalities }}</strong><small>cadastradas</small></span></article><article><i>≡</i><span>Fila de espera<strong>{{ stats.waitlist }}</strong><small>registros</small></span></article></section>
<div class="org-dashboard-grid">
 <article class="panel"><div class="panel-title"><div><h3>Notificações por canal</h3><p>{{ stats.notifications }} envios registrados</p></div><span>▧</span></div>{% if notificationTypes %}<div class="metric-list">{% set maxNotification=max(notificationTypes) %}{% for type,total in notificationTypes %}<div><label><b>{{ type|capitalize }}</b><strong>{{ total }}</strong></label><progress max="{{ maxNotification }}" value="{{ total }}"></progress></div>{% endfor %}</div>{% else %}<div class="empty"><p>Nenhuma notificação registrada.</p></div>{% endif %}
 </article>
 <article class="panel"><div class="panel-title"><div><h3>Situação das notificações</h3><p>Resultado dos envios</p></div><span>✓</span></div>{% if notificationStatus %}<div class="status-cloud">{% for status,total in notificationStatus %}<span class="status-{{ status }}"><b>{{ total }}</b>{{ status|capitalize }}</span>{% endfor %}</div>{% else %}<div class="empty"><p>Sem dados de envio.</p></div>{% endif %}</article>
 <article class="panel"><div class="panel-title"><div><h3>Frequência dos alunos</h3><p>{{ attendance|reduce((sum,v)=>sum+v,0) }} registros</p></div><span>✓</span></div>{% if attendance %}<div class="status-cloud">{% for status,total in attendance %}<span><b>{{ total }}</b>{{ status|capitalize }}</span>{% endfor %}</div>{% else %}<div class="empty"><p>Nenhuma chamada realizada.</p></div>{% endif %}</article>
 <article class="panel"><div class="panel-title"><div><h3>Resumo financeiro</h3><p>{{ stats.financeEntries }} movimentações</p></div><span>$</span></div><div class="finance-overview"><span>Receitas<b>R$ {{ finance.receita|number_format(2,',','.') }}</b></span><span>Despesas<b>R$ {{ finance.despesa|number_format(2,',','.') }}</b></span><span>Saldo<b>R$ {{ (finance.receita-finance.despesa)|number_format(2,',','.') }}</b></span></div></article>
</div>
<article class="panel recent-notifications"><div class="panel-title"><div><h3>Notificações recentes</h3><p>Últimos registros desta ONG</p></div></div><div class="notification-table"><div class="notification-row header"><span>Data</span><span>Canal</span><span>Destinatário</span><span>Status</span><span>Mensagem</span></div>{% for notification in notifications %}<div class="notification-row"><span>{{ notification.criadoEm|date('d/m/Y H:i') }}</span><span>{{ notification.canal|capitalize }}</span><span>{{ notification.destinatario }}</span><span><i class="badge {{ notification.status=='enviado'?'ok':(notification.status=='pendente'?'':'off') }}">{{ notification.status|capitalize }}</i></span><span title="{{ notification.mensagem }}">{{ notification.mensagem }}</span></div>{% else %}<div class="empty"><p>Nenhuma notificação registrada.</p></div>{% endfor %}</div></article>
<details class="panel org-details"><summary>Dados e usuários da organização</summary><form method="post" class="crud-form"><input type="hidden" name="_token" value="{{ csrf_token('project-'~project.id) }}"><div class="form-grid"><label>Nome do projeto *<input name="nome" required value="{{ project.nome }}"></label><label>CNPJ *<input class="cnpj-mask" name="cnpj" required inputmode="numeric" maxlength="18" value="{{ project.cnpj }}"></label><label>E-mail<input type="email" name="email" value="{{ project.email }}"></label><label>Telefone<input name="telefone" value="{{ project.telefone }}"></label><label><span class="check"><input type="checkbox" name="ativo" value="1" {{ project.ativo?'checked':'' }}> Projeto ativo</span></label></div><div class="form-actions"><button>Salvar projeto</button></div></form><h3>Usuários deste projeto</h3><div class="crud-row user-row crud-header"><span>Nome</span><span>E-mail</span><span>Perfil</span><span>Status</span><span></span></div>{% for user in users %}<div class="crud-row user-row"><span>{{ user.nome }}</span><span>{{ user.email }}</span><span>{{ user.roles[0]|replace({'ROLE_':''}) }}</span><span><i class="badge {{ user.ativo?'ok':'off' }}">{{ user.ativo?'Ativo':'Inativo' }}</i></span><span></span></div>{% endfor %}</details>
<script src="{{ asset('scripts/documents.js') }}"></script>
{% endblock %}
