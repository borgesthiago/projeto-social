{% extends 'superadmin/base.html.twig' %}{% block title %}Gerenciar {{ project.nome }}{% endblock %}{% block body %}<link rel="stylesheet" href="{{ asset('styles/superadmin-project.css') }}?v=20260804-2"><link rel="stylesheet" href="{{ asset('styles/superadmin-details.css') }}?v=20260804-1"><div class="page-head"><div><a class="back-link" href="{{ path('app_superadmin_index') }}">← Organizações</a><h1>{{ project.nome }}</h1><p>CNPJ {{ project.cnpj|default('não informado') }} · {{ project.slug }}</p></div><div class="detail-head-actions"><a class="secondary-btn" href="{{ path('app_superadmin_project_details',{id:project.id}) }}">Ver detalhes</a>{% if subscription %}<a class="primary-btn" href="{{ path('app_superadmin_subscription_edit',{id:subscription.id}) }}">Gerenciar assinatura</a>{% endif %}</div></div>{% if subscription %}<div class="subscription-summary"><span>Plano <b>{{ subscription.plano.nome }}</b></span><span>Status <b>{{ subscription.status }}</b></span><span>Vencimento <b>{{ subscription.vencimento|date('d/m/Y') }}</b></span><span>Acesso <b>{{ subscription.acessoLiberado?'Liberado':'Bloqueado' }}</b></span></div>{% endif %}<form method="post" class="panel crud-form"><input type="hidden" name="_token" value="{{ csrf_token('project-'~project.id) }}"><div class="form-grid"><label>Nome do projeto *<input name="nome" required value="{{ project.nome }}"></label><label>CNPJ *<input class="cnpj-mask" name="cnpj" required inputmode="numeric" maxlength="18" value="{{ project.cnpj }}"></label><label>E-mail<input type="email" name="email" value="{{ project.email }}"></label><label>Telefone<input name="telefone" value="{{ project.telefone }}"></label><label><span class="check"><input type="checkbox" name="ativo" value="1" {{ project.ativo?'checked':'' }}> Projeto ativo</span></label></div><div class="form-actions"><a href="{{ path('app_superadmin_index') }}">Cancelar</a><button>Salvar projeto</button></div></form><article class="panel data-table"><h3>Usuários deste projeto</h3><div class="crud-row user-row crud-header"><span>Nome</span><span>E-mail</span><span>Perfil</span><span>Status</span><span></span></div>{% for user in users %}<div class="crud-row user-row"><span>{{ user.nome }}</span><span>{{ user.email }}</span><span>{{ user.roles[0]|replace({'ROLE_':''}) }}</span><span><i class="badge {{ user.ativo?'ok':'off' }}">{{ user.ativo?'Ativo':'Inativo' }}</i></span><span></span></div>{% endfor %}</article><script src="{{ asset('scripts/documents.js') }}"></script>{% endblock %}
