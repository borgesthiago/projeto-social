{% extends 'superadmin/base.html.twig' %}{% block title %}Detalhes de {{ project.nome }}{% endblock %}{% block body %}<link rel="stylesheet" href="{{ asset('styles/superadmin-project.css') }}?v=20260804-2"><link rel="stylesheet" href="{{ asset('styles/superadmin-details.css') }}?v=20260804-1"><div class="page-head"><div><a class="back-link" href="{{ path('app_superadmin_index') }}">← Organizações</a><h1>Detalhes de {{ project.nome }}</h1><p>Visão completa dos cadastros e da operação desta ONG.</p></div><div class="detail-head-actions"><a class="secondary-btn" href="{{ path('app_superadmin_project',{id:project.id}) }}">Gerenciar ONG</a>{% if subscription %}<a class="primary-btn" href="{{ path('app_superadmin_subscription_edit',{id:subscription.id}) }}">Gerenciar assinatura</a>{% endif %}</div></div>{% if subscription %}<div class="subscription-summary"><span>Plano <b>{{ subscription.plano.nome }}</b></span><span>Status <b>{{ subscription.status|capitalize }}</b></span><span>Vencimento <b>{{ subscription.vencimento|date('d/m/Y') }}</b></span><span>Acesso <b>{{ subscription.acessoLiberado?'Liberado':'Bloqueado' }}</b></span></div>{% endif %}
{% set cards=[['♙','Alunos',stats.students,stats.activeStudents~' ativos'],['♧','Responsáveis',stats.responsibles,'cadastrados'],['♟','Professores',stats.teachers,'cadastrados'],['▤','Modalidades e cursos',stats.modalities,'cadastrados'],['▦','Turmas',stats.classes,stats.activeClasses~' ativas'],['▣','Aulas',stats.lessons,'registradas'],['✓','Frequências',stats.attendance,'lançamentos'],['≡','Fila de espera',stats.waitlist,'registros'],['☷','Critérios da fila',stats.priorities,'cadastrados'],['$','Financeiro',stats.financeEntries,'movimentações'],['▧','Notificações',stats.notifications,'registros'],['♙','Usuários',stats.users,stats.activeUsers~' ativos'],['◎','Transparência',stats.publicEntries,'lançamentos públicos'],['⚙','Configurações',stats.settings,'parâmetros salvos']] %}<section class="org-kpis detail-kpis">{% for card in cards %}<article><i>{{ card[0] }}</i><span>{{ card[1] }}<strong>{{ card[2] }}</strong><small>{{ card[3] }}</small></span></article>{% endfor %}</section>
<div class="org-dashboard-grid"><article class="panel"><div class="panel-title"><div><h3>Notificações por canal</h3><p>{{ stats.notifications }} envios registrados</p></div><span>▧</span></div>{% if notificationTypes %}<div class="metric-list">{% set highest=max(notificationTypes) %}{% for type,total in notificationTypes %}<div><label><b>{{ type|capitalize }}</b><strong>{{ total }}</strong></label><progress max="{{ highest }}" value="{{ total }}"></progress></div>{% endfor %}</div>{% else %}<div class="empty"><p>Nenhuma notificação registrada.</p></div>{% endif %}</article><article class="panel"><div class="panel-title"><div><h3>Situação das notificações</h3><p>Resultado dos envios</p></div><span>✓</span></div>{% if notificationStatus %}<div class="status-cloud">{% for status,total in notificationStatus %}<span><b>{{ total }}</b>{{ status|capitalize }}</span>{% endfor %}</div>{% else %}<div class="empty"><p>Sem dados de envio.</p></div>{% endif %}</article><article class="panel"><div class="panel-title"><div><h3>Frequência dos alunos</h3><p>{{ stats.attendance }} lançamentos</p></div><span>✓</span></div>{% if attendance %}<div class="status-cloud">{% for status,total in attendance %}<span><b>{{ total }}</b>{{ status|capitalize }}</span>{% endfor %}</div>{% else %}<div class="empty"><p>Nenhuma chamada realizada.</p></div>{% endif %}</article><article class="panel"><div class="panel-title"><div><h3>Resumo financeiro</h3><p>{{ stats.financeEntries }} movimentações</p></div><span>$</span></div><div class="finance-overview"><span>Receitas<b>R$ {{ finance.receita|number_format(2,',','.') }}</b></span><span>Despesas<b>R$ {{ finance.despesa|number_format(2,',','.') }}</b></span><span>Saldo<b>R$ {{ (finance.receita-finance.despesa)|number_format(2,',','.') }}</b></span></div></article></div>
<article class="panel recent-notifications"><div class="panel-title"><div><h3>Notificações recentes</h3><p>Últimos registros desta ONG</p></div></div><div class="notification-table"><div class="notification-row header"><span>Data</span><span>Canal</span><span>Destinatário</span><span>Status</span><span>Mensagem</span></div>{% for notification in notifications %}<div class="notification-row"><span>{{ notification.criadoEm|date('d/m/Y H:i') }}</span><span>{{ notification.canal|capitalize }}</span><span>{{ notification.destinatario }}</span><span><i class="badge {{ notification.status=='enviado'?'ok':'off' }}">{{ notification.status|capitalize }}</i></span><span title="{{ notification.mensagem }}">{{ notification.mensagem }}</span></div>{% else %}<div class="empty"><p>Nenhuma notificação registrada.</p></div>{% endfor %}</div></article>{% endblock %}
