{% extends 'superadmin/base.html.twig' %}{% block body %}<div class="page-head"><div><a class="back-link" href="{{ path('app_superadmin_subscriptions') }}">← Assinaturas</a><h1>{{ subscription.projeto.nome }}</h1><p>Gerencie a liberação de acesso desta ONG.</p></div></div><form method="post" class="panel crud-form"><input type="hidden" name="_token" value="{{ csrf_token('subscription-'~subscription.id) }}"><div class="form-grid"><label>Plano<select name="plano">{% for plan in plans %}<option value="{{ plan.id }}" {{ subscription.plano.id==plan.id?'selected':'' }}>{{ plan.nome }}</option>{% endfor %}</select></label><label>Status<select name="status">{% for value,label in {'teste':'Período de teste','ativa':'Ativa','atrasada':'Pagamento atrasado','suspensa':'Suspensa','cancelada':'Cancelada'} %}<option value="{{ value }}" {{ subscription.status==value?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label><label>Vencimento<input type="date" name="vencimento" value="{{ subscription.vencimento|date('Y-m-d') }}" required></label><label>Dias de carência<input type="number" min="0" name="diasCarencia" value="{{ subscription.diasCarencia }}"></label><label>Limite personalizado de usuários<input type="number" min="1" name="limiteUsuarios" value="{{ subscription.limiteUsuariosPersonalizado }}" placeholder="Usar limite do plano"></label></div><div class="access-box {{ subscription.acessoLiberado?'allowed':'blocked' }}">{{ subscription.acessoLiberado?'Acesso atualmente liberado':'Acesso atualmente bloqueado' }}</div><div class="form-actions"><button>Salvar assinatura</button></div></form>{% endblock %}
