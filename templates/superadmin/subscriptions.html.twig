{% extends 'superadmin/base.html.twig' %}{% block title %}Assinaturas{% endblock %}{% block body %}<div class="page-head"><div><h1>Assinaturas</h1><p>Controle planos, vencimentos, carência e liberação de acesso.</p></div></div><article class="panel"><div class="crud-row subscription-row crud-header"><span>ONG</span><span>Plano</span><span>Status</span><span>Vencimento</span><span>Limite</span><span>Ações</span></div>{% for item in subscriptions %}<div class="crud-row subscription-row"><span><b>{{ item.projeto.nome }}</b></span><span>{{ item.plano.nome }}</span><span><i class="badge {{ item.acessoLiberado?'ok':'off' }}">{{ item.status }}</i></span><span>{{ item.vencimento|date('d/m/Y') }}<small> +{{ item.diasCarencia }} dias</small></span><span>{{ item.limiteUsuarios }} usuários</span><span><a href="{{ path('app_superadmin_subscription_edit',{id:item.id}) }}">Gerenciar</a></span></div>{% else %}<div class="empty">Nenhuma assinatura.</div>{% endfor %}</article>{% endblock %}
