<header class="transparency-heading"><div><span class="transparency-kicker">Prestação de contas</span><h1>Transparência e impacto</h1><p>Acompanhe os recursos publicados e os resultados sociais de {{ project.nome }}.</p></div>{% if not publicMode %}<a class="transparency-share" href="{{ path('app_transparency_public',{slug:project.slug}) }}" target="_blank">↗ Abrir portal público</a>{% endif %}</header>
<section class="transparency-impact"><article><span>♙</span><div><strong>{{ impact.students }}</strong><small>alunos ativos</small></div></article><article><span>▦</span><div><strong>{{ impact.classes }}</strong><small>turmas em atividade</small></div></article><article><span>✓</span><div><strong>{{ impact.lessons }}</strong><small>aulas realizadas</small></div></article><article><span>▣</span><div><strong>{{ entries|length }}</strong><small>lançamentos publicados</small></div></article></section>
<form class="transparency-filters" method="get"><label>Exercício<select name="ano"><option value="">Todos os anos</option>{% for option in years %}<option value="{{ option }}" {{ filters.ano==option?'selected':'' }}>{{ option }}</option>{% endfor %}</select></label><label>Tipo<select name="tipo"><option value="">Receitas e despesas</option><option value="receita" {{ filters.tipo=='receita'?'selected':'' }}>Receitas</option><option value="despesa" {{ filters.tipo=='despesa'?'selected':'' }}>Despesas</option></select></label><label>Categoria<select name="categoria"><option value="">Todas as categorias</option>{% for option in categories %}<option value="{{ option }}" {{ filters.categoria==option?'selected':'' }}>{{ option }}</option>{% endfor %}</select></label><button>Aplicar filtros</button><a href="{{ publicMode ? path('app_transparency_public',{slug:project.slug}) : path('app_transparency') }}">Limpar</a></form>
<section class="transparency-totals"><article class="income"><small>Receitas publicadas</small><strong>R$ {{ totals.income|number_format(2,',','.') }}</strong><span>↗</span></article><article class="expense"><small>Despesas publicadas</small><strong>R$ {{ totals.expenses|number_format(2,',','.') }}</strong><span>↘</span></article><article class="balance"><small>Saldo do período</small><strong>R$ {{ totals.balance|number_format(2,',','.') }}</strong><span>$</span></article></section>
<section class="transparency-grid"><article class="transparency-card"><h2>Evolução financeira</h2><div class="transparency-bars">{% set maxValue=1 %}{% for month,values in monthly %}{% set maxValue=max(maxValue,values.receita,values.despesa) %}{% endfor %}{% for month,values in monthly %}<div><span class="bar income" style="height:{{ max(3,values.receita*100/maxValue) }}%" title="Receitas: R$ {{ values.receita|number_format(2,',','.') }}"></span><span class="bar expense" style="height:{{ max(3,values.despesa*100/maxValue) }}%" title="Despesas: R$ {{ values.despesa|number_format(2,',','.') }}"></span><small>{{ (month~'-01')|date('m/y') }}</small></div>{% else %}<p>Nenhum dado no período.</p>{% endfor %}</div><footer><i></i> Receitas <i></i> Despesas</footer></article><article class="transparency-card"><h2>Despesas por categoria</h2><div class="category-list">{% for category,value in byCategory %}<div><label><span>{{ category }}</span><b>R$ {{ value|number_format(2,',','.') }}</b></label><progress value="{{ value }}" max="{{ totals.expenses ?: 1 }}"></progress></div>{% else %}<p>Nenhuma despesa publicada no período.</p>{% endfor %}</div></article></section>
<article class="transparency-card transparency-statement"><header><div><h2>Demonstrativo publicado</h2><p>Somente movimentações autorizadas pela organização são exibidas.</p></div><button type="button" onclick="window.print()">⇩ Imprimir</button></header><div class="transparency-table"><div class="transparency-row table-head"><span>Data</span><span>Descrição</span><span>Categoria</span><span>Tipo</span><span>Valor</span><span>Documento</span></div>{% for entry in entries %}<div class="transparency-row"><span>{{ entry.data|date('d/m/Y') }}</span><span><b>{{ entry.descricao }}</b></span><span>{{ entry.categoria ?: 'Sem categoria' }}</span><span><i class="{{ entry.tipo }}">{{ entry.tipo|capitalize }}</i></span><span class="money {{ entry.tipo }}">{{ entry.tipo=='despesa'?'-':'+' }} R$ {{ entry.valor|number_format(2,',','.') }}</span><span>{% if entry.comprovante %}<a href="{{ entry.comprovante }}" target="_blank" rel="noopener noreferrer">Ver comprovante ↗</a>{% else %}<small>Não publicado</small>{% endif %}</span></div>{% else %}<div class="transparency-empty">Nenhum lançamento encontrado com estes filtros.</div>{% endfor %}</div></article>
