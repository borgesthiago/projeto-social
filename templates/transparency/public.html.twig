<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Transparência — {{ project.nome }}</title><link rel="stylesheet" href="{{ asset('styles/app.css') }}"><link rel="stylesheet" href="{{ asset('styles/transparency.css') }}"><style>:root{--blue:{{ project.corPrimaria }};--secondary:{{ project.corSecundaria }}}</style></head><body class="public-transparency"><header class="public-header"><div>{% if project.logoPath %}<img src="{{ project.logoPath }}" alt="Logo de {{ project.nome }}">{% else %}<b>PS</b>{% endif %}<span><strong>{{ project.nome }}</strong><small>{{ project.slogan ?: 'Compromisso com transparência e impacto social' }}</small></span></div><span>Portal público de transparência</span></header><main class="transparency-page public-container">{% include 'transparency/_content.html.twig' %}<footer class="public-footer"><b>{{ project.nome }}</b><span>{{ settings.endereco|default('') }}</span><span>{{ project.email }}{% if project.telefone %} · {{ project.telefone }}{% endif %}</span><small>Dados publicados pela própria organização.</small></footer></main></body></html>
