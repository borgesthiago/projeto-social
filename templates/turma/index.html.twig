{% extends 'base.html.twig' %}
{% block title %}Gestão de Turmas{% endblock %}
{% block body %}
<div class="page-head class-page-head"><div><h1><span>♧</span> Gestão de Turmas</h1><p>Crie e gerencie as turmas, professores e alunos.</p></div><a class="primary-btn" href="{{ path('app_crud_new',{resource:'turmas'}) }}">＋ Nova turma</a></div>
<form class="toolbar class-search" method="get"><input name="q" value="{{ q }}" placeholder="Pesquisar turma ou horário..."><button>Pesquisar</button>{% if q %}<a href="{{ path('app_turma_index') }}">Limpar</a>{% endif %}</form>
<div class="class-card-grid">{% for turma in classes %}{% set enrolled=occupancy[turma.id] %}{% set percent=turma.limiteAlunos ? min(100,(enrolled*100/turma.limiteAlunos)) : 0 %}<article class="class-management-card"><header><div><h2>{{ turma.nome }}</h2><span>{{ turma.modalidade.nome }}</span></div><div class="actions"><a class="icon-action" href="{{ path('app_turma_show',{id:turma.id}) }}" title="Visualizar turma" aria-label="Visualizar turma">◉</a>{% if is_granted('ROLE_MASTER') or is_granted('ROLE_ADMINISTRATIVO') %}<a class="icon-action" href="{{ path('app_crud_edit',{resource:'turmas',id:turma.id}) }}" title="Editar turma" aria-label="Editar turma">✎</a>{% endif %}</div></header><p>{{ turma.horario ?: 'Horário não informado.' }}</p><div class="class-detail-line"><span>♙</span><span>Professor: <b>{{ turma.professor ? turma.professor.nome : 'A definir' }}</b></span></div><div class="class-capacity"><label><span>♧ Lotação</span><b>{{ enrolled }} / {{ turma.limiteAlunos }}</b></label><progress value="{{ enrolled }}" max="{{ turma.limiteAlunos }}"></progress></div><footer>{% if is_granted('ROLE_MASTER') or is_granted('ROLE_ADMINISTRATIVO') %}<a href="{{ path('app_turma_enroll',{id:turma.id}) }}">＋ Matricular</a>{% endif %}<a href="{{ path('app_turma_show',{id:turma.id}) }}">▣ Relatório</a></footer></article>{% else %}<article class="panel empty large"><span>○</span><h3>Nenhuma turma encontrada</h3><p>{{ q ? 'Tente pesquisar por outro termo.' : 'Cadastre a primeira turma do projeto.' }}</p></article>{% endfor %}</div>
{% endblock %}
