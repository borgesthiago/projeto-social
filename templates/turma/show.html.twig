{% extends 'base.html.twig' %}
{% block title %}{{ turma.nome }} | Relatório da turma{% endblock %}
{% block body %}
<div class="class-report-top"><a class="secondary-btn" href="{{ path('app_turma_index') }}">← Voltar para turmas</a><button class="secondary-btn" type="button" onclick="window.print()">⇩ Exportar relatório</button></div><header class="class-report-title"><h1>Relatório completo — {{ turma.nome }}</h1><p>{{ turma.modalidade.nome }} · Professor: {{ turma.professor ? turma.professor.nome : 'A definir' }} · Ano letivo {{ turma.anoLetivo }}</p></header>
<div class="class-report-stats"><article class="blue"><small>Total de aulas</small><strong>{{ stats.lessons }}</strong><span>▣</span></article><article class="green"><small>Aulas realizadas</small><strong>{{ stats.completed }}</strong><span>✓</span></article><article class="purple"><small>Frequência média</small><strong>{{ stats.attendance|number_format(1,',','.') }}%</strong><span>⌁</span></article><article class="orange"><small>Alunos ativos</small><strong>{{ stats.students }}</strong><span>♧</span></article></div>
<article class="panel class-report-panel"><h3>▣ Cronograma de aulas</h3><div class="report-table"><div class="report-row report-header"><span>#</span><span>Título</span><span>Data</span><span>Horário</span><span>Status</span><span>Planejamento</span><span>Execução</span><span>Frequência</span></div>{% for lesson in lessons %}<div class="report-row"><span>{{ loop.index }}</span><span><b>{{ lesson.titulo }}</b></span><span>{{ lesson.dataHora|date('d/m/Y') }}</span><span>{{ lesson.dataHora|date('H:i') }}</span><span><i class="badge {{ lesson.status=='finalizada'?'ok':'off' }}">{{ lesson.status }}</i></span><span>{{ lesson.planejamento ? '✓' : '—' }}</span><span>{{ lesson.execucao ? '✓' : '—' }}</span><span>{% if is_granted('ROLE_MASTER') or is_granted('ROLE_PROFESSOR') %}<a class="icon-action" href="{{ path('app_attendance_call',{id:lesson.id}) }}" title="{{ lessonAttendance[lesson.id] ? 'Revisar frequência' : 'Dar frequência' }}" aria-label="{{ lessonAttendance[lesson.id] ? 'Revisar frequência' : 'Dar frequência' }}">✓</a>{% else %}—{% endif %}</span></div>{% else %}<div class="empty"><p>Nenhuma aula cadastrada para esta turma.</p></div>{% endfor %}</div></article>
<article class="panel class-report-panel"><div class="student-panel-title"><h3>♧ Frequência dos alunos</h3>{% if is_granted('ROLE_MASTER') or is_granted('ROLE_ADMINISTRATIVO') %}<a class="primary-btn" href="{{ path('app_turma_enroll',{id:turma.id}) }}">＋ Matricular aluno</a>{% endif %}</div><div class="student-frequency-list">{% for student in students %}<div class="student-frequency-row"><span class="student-avatar">{{ student.nome|slice(0,1)|upper }}</span><div><b>{{ student.nome }}</b><small>Status: {{ student.status }}</small></div><div><b>{{ rates[student.id]|number_format(1,',','.') }}%</b><small>Frequência</small><progress value="{{ rates[student.id] }}" max="100"></progress></div></div>{% else %}<div class="empty"><p>Nenhum aluno ativo matriculado nesta turma.</p></div>{% endfor %}</div></article>
{% endblock %}
