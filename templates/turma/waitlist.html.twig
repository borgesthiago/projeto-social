{% extends 'base.html.twig' %}{% block title %}Fila — {{ turma.nome }}{% endblock %}{% block body %}<div class="page-head"><div><a class="back-link" href="{{ path('app_crud_index',{resource:'turmas'}) }}">← Turmas</a><h1>Fila de espera — {{ turma.nome }}</h1><p>{{ turma.modalidade.nome }} · {{ turma.idadeMinima }} a {{ turma.idadeMaxima }} anos · limite de {{ turma.limiteAlunos }} alunos</p></div><a class="primary-btn" href="{{ path('app_crud_new',{resource:'fila-espera',turma:turma.id}) }}">＋ Adicionar à fila</a></div><article class="panel"><div class="crud-row waitlist-row crud-header"><span>Posição</span><span>Nome</span><span>Idade</span><span>Pontuação</span><span>Situação</span></div>{% for person in queue %}<div class="crud-row waitlist-row"><span><b>{{ loop.index }}º</b></span><span>{{ person.aluno.nome }}</span><span>{{ person.aluno.idade }} anos</span><span>{{ person.aluno.pontuacao }}</span><span><i class="badge {{ person.status=='aguardando'?'ok':'off' }}">{{ person.status }}</i></span></div>{% else %}<div class="empty large"><h3>Fila vazia</h3><p>Nenhuma pessoa aguarda vaga nesta turma.</p></div>{% endfor %}</article>{% endblock %}
