{% extends 'base.html.twig' %}
{% block title %}Aceitar convite{% endblock %}
{% block guest %}<div class="login-page"><div class="login-art"><div><span class="big-logo">PS</span><h1>{{ invited_user.projeto.nome }}</h1><p>Você foi convidado para participar da equipe.</p></div></div><form method="post" class="login-card"><div><h2>Ativar sua conta</h2><p>{{ invited_user.nome }} · {{ invited_user.email }}</p></div>{% for error in errors %}<div class="alert">{{ error }}</div>{% endfor %}<label>Crie sua senha<input type="password" name="password" minlength="8" required autocomplete="new-password"></label><label>Confirme a senha<input type="password" name="confirmPassword" minlength="8" required autocomplete="new-password"></label><input type="hidden" name="_token" value="{{ csrf_token('accept-invite-'~token) }}"><button>Ativar conta</button></form></div>{% endblock %}
