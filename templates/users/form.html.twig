{% extends 'base.html.twig' %}{% block body %}<div class="page-head"><div><a class="back-link" href="{{ path('app_users_index') }}">← Voltar</a><h1>{{ is_new?'Novo usuário':'Editar usuário' }}</h1></div></div>{% for error in errors %}<div class="alert">{{ error }}</div>{% endfor %}<form method="post" class="panel crud-form"><input type="hidden" name="_token" value="{{ csrf_token('user-form') }}"><div class="form-grid"><label>Nome *<input name="nome" required value="{{ managed_user.nome }}"></label><label>E-mail *<input type="email" name="email" required value="{{ managed_user.email }}"></label><label>Perfil *<select name="role">{% for value,label in {'ROLE_ADMINISTRATIVO':'Administrativo','ROLE_PROFESSOR':'Professor','ROLE_FINANCEIRO':'Financeiro','ROLE_RESPONSAVEL':'Responsável','ROLE_ALUNO':'Aluno','ROLE_MASTER':'Master'} %}<option value="{{ value }}" {{ value in managed_user.roles?'selected':'' }}>{{ label }}</option>{% endfor %}</select></label><label>Senha {{ is_new?'*':'(deixe vazia para manter)' }}<input type="password" name="password" {{ is_new?'required minlength="8"':'' }}></label><label><span class="check"><input type="checkbox" name="ativo" value="1" {{ managed_user.ativo?'checked':'' }}> Usuário ativo</span></label></div><div class="form-actions"><a href="{{ path('app_users_index') }}">Cancelar</a><button>Salvar usuário</button></div></form>{% endblock %}
