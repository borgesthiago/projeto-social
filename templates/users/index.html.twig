{% extends 'base.html.twig' %}
{% block title %}Gestão de Usuários{% endblock %}
{% block body %}
<div class="page-head"><div><h1><span>♧</span> Gestão de Usuários</h1><p>Gerencie usuários e suas permissões no sistema.</p></div><button class="primary-btn" type="button" data-toggle-invite>＋ Convidar usuário</button></div>
<section class="user-invite" data-invite-panel><header>✉ Convidar novo usuário</header><form method="post" action="{{ path('app_users_invite') }}"><input type="hidden" name="_token" value="{{ csrf_token('user-invite') }}"><label>E-mail *<input type="email" name="email" required placeholder="usuario@email.com"></label><label>Perfil de acesso *<select name="role" required><option value="">Selecione o perfil</option>{% for value,label in roles %}<option value="{{ value }}">{{ label }}</option>{% endfor %}</select></label><label>Nome completo <small>(opcional)</small><input name="nome" placeholder="Nome do usuário"></label><label class="invite-message">Mensagem do convite<textarea name="mensagem" rows="4">Você foi convidado para participar do sistema de gestão de {{ app.user.projeto.nome }}. Use o link do convite para criar sua senha e acessar sua conta.</textarea></label><div class="invite-actions"><button type="button" data-cancel-invite>× Cancelar</button><button type="submit">➤ Enviar convite</button></div></form></section>
<article class="panel user-management"><form class="user-filters" method="get" data-user-filter><input name="q" value="{{ filters.q }}" placeholder="Buscar por nome ou e-mail..." data-user-name><select name="role" data-user-role><option value="">Todos os perfis</option>{% for value,label in roles %}<option value="{{ value }}" {{ filters.role==value?'selected':'' }}>{{ label }}</option>{% endfor %}</select></form><div class="user-management-table"><div class="user-management-row user-management-header"><span>Usuário</span><span>E-mail</span><span>Perfil</span><span>Status</span><span>Ações</span></div>{% for managed in users %}{% set main_role=managed.roles[0]|default('ROLE_USER') %}<div class="user-management-row"><span class="user-identity"><i>{{ managed.nome|slice(0,1)|upper }}</i><span><b>{{ managed.nome }}</b><small>ID: {{ managed.id }}</small></span></span><span>✉ {{ managed.email }}</span><span><i class="user-role {{ main_role|lower }}">{{ roles[main_role]|default(main_role|replace({'ROLE_':''})|title) }}</i></span><span>{% if managed.convitePendente %}<i class="user-state pending">Convite pendente</i>{% else %}<i class="user-state {{ managed.ativo?'active':'inactive' }}">{{ managed.ativo?'Ativo':'Inativo' }}</i>{% endif %}</span><span class="actions"><a class="icon-action" href="{{ path('app_users_edit',{id:managed.id}) }}" title="Editar usuário" aria-label="Editar usuário">✎</a>{% if managed != app.user %}<form method="post" action="{{ path('app_users_delete',{id:managed.id}) }}" onsubmit="return confirm('Excluir este usuário?')"><input type="hidden" name="_token" value="{{ csrf_token('delete-user-'~managed.id) }}"><button class="icon-action danger" title="Excluir usuário" aria-label="Excluir usuário">×</button></form>{% endif %}</span></div>{% else %}<div class="empty large"><span>○</span><h3>Nenhum usuário encontrado</h3></div>{% endfor %}</div></article>
<div class="user-role-summary">{% for value,label in roles %}<article><strong>{{ counts[value] }}</strong><small>{{ label }}</small></article>{% endfor %}</div>
<script>const invitePanel=document.querySelector('[data-invite-panel]');document.querySelector('[data-toggle-invite]')?.addEventListener('click',()=>invitePanel.classList.toggle('hidden'));document.querySelector('[data-cancel-invite]')?.addEventListener('click',()=>invitePanel.classList.add('hidden'));const userFilter=document.querySelector('[data-user-filter]');document.querySelector('[data-user-role]')?.addEventListener('change',()=>userFilter.submit());let userTimer;document.querySelector('[data-user-name]')?.addEventListener('input',()=>{clearTimeout(userTimer);userTimer=setTimeout(()=>userFilter.submit(),500)})</script>
{% endblock %}
