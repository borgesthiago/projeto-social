{% extends 'base.html.twig' %}
{% block title %}Fila de Espera{% endblock %}
{% block body %}
<div class="page-head"><div><h1><span>◷</span> Fila de Espera</h1><p>Gerencie a fila de espera para vagas nas turmas.</p></div><a class="primary-btn" href="{{ path('app_crud_new',{resource:'fila-espera'}) }}">＋ Novo na fila</a></div>
<div class="waitlist-summary">{% for turma in classes %}<a href="{{ path('app_waitlist_index',{turma:turma.id,status:'aguardando'}) }}"><b>{{ turma.nome }}</b><strong>{{ counts[turma.id] }}</strong><small>na fila de espera</small></a>{% else %}<div class="panel empty"><p>Nenhuma turma cadastrada.</p></div>{% endfor %}</div>
<article class="panel waitlist-filters"><h3>▽ Filtros</h3><form method="get" data-waitlist-filter><input name="nome" value="{{ filters.nome }}" placeholder="Buscar por nome..." data-waitlist-name><select name="turma" data-waitlist-auto><option value="">Todas as turmas</option>{% for turma in classes %}<option value="{{ turma.id }}" {{ filters.turma==turma.id?'selected':'' }}>{{ turma.nome }}</option>{% endfor %}</select><select name="status" data-waitlist-auto><option value="">Todas as situações</option><option value="aguardando" {{ filters.status=='aguardando'?'selected':'' }}>Aguardando</option><option value="convocado" {{ filters.status=='convocado'?'selected':'' }}>Convocado</option><option value="matriculado" {{ filters.status=='matriculado'?'selected':'' }}>Matriculado</option><option value="desistente" {{ filters.status=='desistente'?'selected':'' }}>Desistente</option></select><a href="{{ path('app_waitlist_index') }}">× Limpar filtros</a><button>Filtrar</button></form></article>
<article class="panel waitlist-results"><h3>Pessoas na fila <small>({{ entries|length }})</small></h3><div class="waitlist-table"><div class="waitlist-result-row waitlist-result-header"><span>Posição</span><span>Nome</span><span>Idade</span><span>Turma</span><span>Contato</span><span>Situação</span><span>Ações</span></div>{% for entry in entries %}<div class="waitlist-result-row"><span>{% if positions[entry.id]|default(null) %}<b class="position-badge">#{{ positions[entry.id] }}</b>{% else %}<b>—</b>{% endif %}<small>Total: <i>{{ entry.aluno.pontuacao }} pts</i></small></span><span><b>{{ entry.aluno.nome }}</b>{% if entry.aluno.responsavel %}<small>Resp.: {{ entry.aluno.responsavel.nome }}</small>{% endif %}</span><span>{{ entry.aluno.idade }} anos</span><span><i class="class-badge">{{ entry.turmaDesejada.nome }}</i></span><span class="waitlist-contact">{% if entry.aluno.telefone %}<small>☎ {{ entry.aluno.telefone }}</small>{% endif %}{% if entry.aluno.responsavel %}<small>✉ {{ entry.aluno.responsavel.email ?: entry.aluno.responsavel.telefone }}</small>{% endif %}</span><span><i class="attendance-status {{ entry.status }}">{{ entry.status }}</i></span><span class="actions"><a class="icon-action" href="{{ path('app_crud_edit',{resource:'alunos',id:entry.aluno.id}) }}" title="Ver cadastro do aluno" aria-label="Ver cadastro do aluno">◉</a><a class="icon-action" href="{{ path('app_crud_edit',{resource:'fila-espera',id:entry.id}) }}" title="Editar inscrição" aria-label="Editar inscrição">✎</a>{% if entry.status in ['aguardando','convocado'] %}<form method="post" action="{{ path('app_waitlist_enroll',{id:entry.id}) }}" onsubmit="return confirm('Matricular este aluno na turma {{ entry.turmaDesejada.nome }}?')"><input type="hidden" name="_token" value="{{ csrf_token('waitlist-enroll-'~entry.id) }}"><button class="waitlist-enroll-btn" title="Matricular aluno">♙ Matricular</button></form>{% endif %}</span></div>{% else %}<div class="empty large"><span>○</span><h3>Nenhuma pessoa encontrada</h3><p>Cadastre um aluno na fila ou altere os filtros.</p></div>{% endfor %}</div></article>
<script>const waitlistForm=document.querySelector('[data-waitlist-filter]');document.querySelectorAll('[data-waitlist-auto]').forEach(field=>field.addEventListener('change',()=>waitlistForm.submit()));let waitlistTimer;document.querySelector('[data-waitlist-name]')?.addEventListener('input',()=>{clearTimeout(waitlistTimer);waitlistTimer=setTimeout(()=>waitlistForm.submit(),500)})</script>
{% endblock %}
